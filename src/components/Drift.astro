---
// Everything suspended in the deep water.
//
// Marine snow rides on this layer's own two pseudo-elements. The contacts are
// cloned out of the template library below, one at a time, by the script at the
// bottom of this file: which species, which lane, which way it is heading and
// how fast are all decided in the browser, so no two visits get the same water.
//
// Every figure in the library is drawn facing RIGHT. Heading is a scaleX on the
// body wrapper, which is the only reason nothing can ever swim backwards -- it
// is one rule in one place rather than a fact about twenty separate drawings.
//
// Drawn hairline and unfilled: the way a sounder or a field notebook records
// something rather than the way an illustration pictures it. Curved bodies come
// out of lib/curves, which explains why.
//
// Foam is telemetry and only telemetry. Buoy is the one warm mark.

import { type Node, spine, shell, ridge, rays } from '@/lib/curves';

// --- School ---------------------------------------------------------------
// Nose at x=21, forked tail behind the origin. These render about 20px long,
// so the list of what still reads is short: a body that is deeper forward than
// aft, a fork, one dorsal, one eye. Everything past that turns to mud.
const FISH =
  // Body. Deepest a third back from the nose, which is what separates a fish
  // from the symmetrical lens shape that reads as clipart.
  'M0 5C3 1.3 7.6-0.8 12.6 0.2c4.4 0.9 7.2 2.5 8.4 4.8-1.2 2.3-4 3.9-8.4 4.8C7.6 10.8 3 8.7 0 5Z' +
  // Forked caudal.
  'M0 5-6.6 0.4-4.1 5-6.6 9.6Z' +
  // Dorsal, then a small anal fin under it.
  'M5 2C6.2-0.5 8.6-1.7 11.2-1.3L9.8 1.4' +
  'M6.4 8.4c0.7 2 1.8 3 3.4 3.2L9 9.2' +
  // Eye. A ring this small closes up into a dot at the size it is seen.
  'M16.2 4.2a0.85 0.85 0 1 0 0.01 0';

// Staggered so that no two bodies overlap: a fish drawn across another fish
// is a tangle of lines at this size, and one tangle spoils the whole school.
// The tagged one at (92, 2) is in this layout too, at 1.25.
const SCHOOL: [number, number, number][] = [
  [4, 0, 0.7],
  [2, 22, 0.9],
  [28, 6, 0.8],
  [38, 36, 0.86],
  [62, 20, 1],
  [98, 32, 0.74],
  [124, 18, 0.8],
];

// --- Oarfish --------------------------------------------------------------
// The longest bony fish there is: a silver ribbon that stands a scarlet crest
// over its head, and the reason sailors kept coming home reporting serpents.
const oar = spine({
  from: 20,
  to: 292,
  steps: 52,
  y: (t) => 52 + Math.sin((1 - t) * 7.4) * 7 + Math.sin((1 - t) * 15) * 2,
  up: [
    [0, 1],
    [0.2, 7],
    [0.5, 13],
    [0.78, 16],
    [0.92, 16.5],
    [1, 12],
  ],
  down: [
    [0, 1],
    [0.2, 7.5],
    [0.5, 13.5],
    [0.8, 16.5],
    [0.93, 15.5],
    [1, 10],
  ],
});

// The dorsal fin runs the whole animal and stays low. Letting it swell toward
// the head instead is what turned the crest into a flag last time round.
const oarFin = (p: Node) => 4 + p.t * 5;
const oarHead = oar[oar.length - 1];

// The crest is a separate thing: the first ten or so dorsal rays, standing
// well clear of the fin behind them and trailing aft. Nothing joins their tips
// -- a line across them is a sail, and a sail is a different fish.
const oarCrest = (() => {
  const mane = oar.filter((p) => p.t >= 0.84);
  return mane
    .map((p, i) => {
      const f = i / (mane.length - 1);
      const h = 17 + f * 27;
      const base = p.y - p.u - 2;
      const top = base - h;
      return (
        `M${p.x.toFixed(1)} ${base.toFixed(1)}` +
        `C${(p.x - 3).toFixed(1)} ${(top + h * 0.55).toFixed(1)}` +
        ` ${(p.x - 6).toFixed(1)} ${(top + h * 0.28).toFixed(1)}` +
        ` ${(p.x - 8 - f * 5).toFixed(1)} ${top.toFixed(1)}`
      );
    })
    .join('');
})();

// --- Thresher shark -------------------------------------------------------
// The upper tail lobe is as long as the rest of the animal. It uses it to
// crack the water like a whip and stun what it is chasing.
const thresher = spine({
  from: 34,
  to: 226,
  y: (t) => 62 - Math.sin(t * 3.1) * 3,
  up: [
    [0, 1.4],
    [0.08, 5],
    [0.34, 14.5],
    [0.5, 15.5],
    [0.74, 12],
    [0.92, 5.5],
    [1, 0.8],
  ],
  down: [
    [0, 1.4],
    [0.08, 5],
    [0.36, 15.5],
    [0.54, 16],
    [0.78, 10],
    [0.94, 4.5],
    [1, 0.8],
  ],
});

// --- Sailfish -------------------------------------------------------------
const sail = spine({
  from: 30,
  to: 236,
  y: () => 66,
  up: [
    [0, 1],
    [0.06, 3.4],
    [0.3, 11],
    [0.52, 12],
    [0.8, 6.5],
    [0.94, 2.6],
    [1, 1.2],
  ],
  down: [
    [0, 1],
    [0.06, 3.6],
    [0.32, 12.5],
    [0.56, 12],
    [0.82, 6],
    [0.95, 2.4],
    [1, 1.2],
  ],
});

// The sail is the whole animal. It stands twice the body's depth and folds
// into a groove when the fish runs, which is why it gets its own curve.
const sailFin = (p: Node) =>
  Math.max(0, Math.sin(Math.min(1, Math.max(0, (p.t - 0.24) / 0.56)) * Math.PI)) ** 0.7 * 40;

// --- Sperm whale ----------------------------------------------------------
// A quarter of it is the case: a tank of oil it uses to focus the loudest
// sound any animal makes. Square on top, undercut below.
const whale = spine({
  from: 44,
  to: 268,
  y: (t) => 62 - t * 5,
  up: [
    [0, 2],
    [0.08, 6],
    [0.34, 18],
    [0.6, 22],
    [0.72, 24],
    [0.95, 24],
    [1, 22],
  ],
  down: [
    [0, 2],
    [0.08, 6],
    [0.36, 17],
    [0.62, 17],
    [0.78, 15],
    [0.92, 13],
    [1, 11],
  ],
});

// --- Anglerfish -----------------------------------------------------------
// The body stops at the jaw hinge. Both jaws are drawn from there as their own
// shapes, because a gape that is only teeth painted onto a silhouette reads as
// a smile rather than as a mouth that opens.
const angler = spine({
  from: 18,
  to: 124,
  y: () => 64,
  up: [
    [0, 1.4],
    [0.12, 5],
    [0.36, 17],
    [0.64, 28],
    [0.86, 31],
    [1, 26],
  ],
  down: [
    [0, 1.4],
    [0.12, 5],
    [0.36, 18],
    [0.64, 30],
    [0.86, 30],
    [1, 24],
  ],
});

/** Teeth stood on a jaw line, so they sit on it rather than near it. */
function teeth(
  x0: number,
  y0: number,
  x1: number,
  y1: number,
  n: number,
  len: number,
  dir: number,
) {
  return Array.from({ length: n }, (_, i) => {
    const t = (i + 0.5) / n;
    const x = x0 + (x1 - x0) * t;
    const y = y0 + (y1 - y0) * t;
    const l = len * (0.55 + 0.75 * Math.sin(t * Math.PI));
    return `M${(x - 3.2).toFixed(1)} ${y.toFixed(1)}L${(x + 1.4).toFixed(1)} ${(y + dir * l).toFixed(1)}L${(x + 3.2).toFixed(1)} ${y.toFixed(1)}`;
  }).join('');
}

// --- Barreleye ------------------------------------------------------------
// The two spots on the front of its face are nostrils. The eyes are the green
// barrels inside the transparent head, and they are pointed straight up.
const barrel = spine({
  from: 16,
  to: 124,
  y: () => 54,
  up: [
    [0, 1],
    [0.12, 4],
    [0.44, 11],
    [0.7, 12.5],
    [0.9, 10],
    [1, 6.5],
  ],
  down: [
    [0, 1],
    [0.12, 4],
    [0.44, 12],
    [0.72, 12.5],
    [0.9, 9],
    [1, 5],
  ],
});

// --- Tripod fish ----------------------------------------------------------
// Stands on three stiffened fin rays, facing into the current, and waits.
// Nearly blind; the two long pectoral rays held out in front are how it finds
// anything at all.
const tripod = spine({
  from: 32,
  to: 152,
  y: () => 44,
  steps: 32,
  up: [
    [0, 1],
    [0.1, 4],
    [0.42, 9],
    [0.72, 8],
    [0.9, 5],
    [1, 1.6],
  ],
});

// --- Squid ----------------------------------------------------------------
// Jets apex first, arms streaming behind, which is the shape it makes when it
// is going somewhere rather than hunting.
const squid = spine({
  from: 70,
  to: 180,
  y: () => 48,
  up: [
    [0, 11],
    [0.18, 13.5],
    [0.5, 11.5],
    [0.8, 6],
    [1, 0.8],
  ],
});

// Eight arms held in a bundle, which is the shape they make when the animal is
// travelling rather than hunting. Spread them out and it turns into a mop.
const ARMS = [
  'M52 45C42 42 30 41 18 40',
  'M52 47C40 45 26 44 12 44',
  'M52 49C38 48 22 48 8 49',
  'M52 51C40 51 26 53 14 55',
  'M52 53C42 55 32 58 22 62',
];

// The two long tentacles do the catching, and the paddle on the end of each is
// the only part with suckers on it.
const TENTACLES = ['M54 43C34 34 14 28-6 26', 'M54 51C32 54 12 62-4 72'];
const CLUBS =
  'M-6 26c-6-1-11 0-13 3 5 2 10 1 13-3ZM-4 72c-6 1-10 4-11 8 5-1 9-4 11-8Z';

// --- Turtle ---------------------------------------------------------------
// A carapace in profile runs about two and a half times as long as it is deep,
// comes to a point over the tail and stops in a blunt wall at the front where
// the neck comes out. Taper it at both ends and it reads as a surfboard.
const shellNodes = spine({
  from: 34,
  to: 112,
  y: () => 50,
  up: [
    [0, 1],
    [0.14, 12],
    [0.36, 20],
    [0.56, 22],
    [0.76, 21],
    [0.92, 18],
    [1, 14],
  ],
  down: [
    [0, 1],
    [0.14, 6],
    [0.4, 10],
    [0.7, 10],
    [0.9, 9],
    [1, 7],
  ],
});

// Two open edges rather than a closed shell: a carapace has no wall across the
// front, it has an opening, and the neck comes out of it.
const carapace =
  'M' +
  shellNodes.map((p) => `${p.x.toFixed(1)} ${(p.y - p.u).toFixed(1)}`).join('L') +
  'M' +
  shellNodes.map((p) => `${p.x.toFixed(1)} ${(p.y + p.d).toFixed(1)}`).join('L');

// --- Hulls ----------------------------------------------------------------
// Three built things share one profile family: a pressure hull is a pressure
// hull whether it is towed, flown or crewed.
const torpedo = (from: number, to: number, y: number, r: number) =>
  spine({
    from,
    to,
    y: () => y,
    steps: 30,
    up: [
      [0, r * 0.34],
      [0.16, r * 0.9],
      [0.62, r],
      [0.9, r * 0.86],
      [1, r * 0.2],
    ],
  });

const towHull = shell(torpedo(30, 132, 34, 11));
const gliderHull = shell(torpedo(26, 148, 38, 9));
const subHull = shell(
  spine({
    from: 26,
    to: 168,
    y: () => 56,
    steps: 34,
    up: [
      [0, 4],
      [0.14, 15],
      [0.5, 19],
      [0.82, 18],
      [1, 8],
    ],
    down: [
      [0, 4],
      [0.14, 14],
      [0.5, 17],
      [0.82, 16],
      [1, 8],
    ],
  }),
);

// --- Siphonophore ---------------------------------------------------------
// A colony, not an animal: a gas float at the top, a stack of swimming bells
// under it that beat together, then metres of feeding stem.
//
// Nectophores in two rows, each a rounded box with its opening turned down
// and out, packed so tightly that each overlaps the next. From a distance a
// nectosome is a cob, not a string of anything: trapezoids read as
// lampshades and circles read as grapes, both because they leave gaps.
const BELLS: [number, number, number, number][] = Array.from({ length: 11 }, (_, i) => [
  28 + (i % 2 ? 4.5 : -4.5),
  24 + i * 7.4,
  i % 2 ? 12 : -12,
  1 - i * 0.028,
]);
const BELL = 'M-6-7h12v9c0 3.5-2.5 6-6 6s-6-2.5-6-6z';
const VELUM = 'M-3 5q3 2 6 0';

// Cormidia down the stem at one interval, because the colony budded them at
// one interval. Each is a bract, a leaf-shaped scale that shields the stem,
// with one tentacle hanging off it, and the tentacles hang at their own
// lengths, which is the difference between a stem and a string of hooks.
const CORMIDIA = Array.from({ length: 9 }, (_, i) => {
  const y = 128 + i * 17;
  const s = i % 2 ? 1 : -1;
  // Shorter than the station interval: a tentacle that reaches the next
  // station's tentacle interleaves with it, and two interleaved curves are
  // a loop.
  const len = 9 + ((i * 5) % 6);
  const bract = `M28 ${y}c${s * 3} -2 ${s * 6} -1 ${s * 7} 2c${-s * 1} 2 ${-s * 4} 3 ${-s * 7} 1Z`;
  // Trails down and away, with one sway in it. Bent back toward the stem it
  // reads as a hook, and a stem of hooks is a vine.
  const tentacle =
    `M${28 + s * 4} ${y + 3}c${s * 3} 3 ${s * 5} 6 ${s * 4} ${len}` +
    `c${-s * 1} 2 ${-s * 1} 3 ${-s * 2} 4`;
  return bract + tentacle;
}).join('');

// --- Moon jellies ---------------------------------------------------------
// Four horseshoes in the bell are the gonads, and they are the only reliable
// way to tell a moon jelly from every other bell in the water.
// Authored at final size rather than drawn once and scaled, so the hairline
// stays a hairline whichever bell it belongs to.
const JELLY = (x: number, y: number, r: number) => {
  const n = (v: number) => v.toFixed(1);
  const scallop = (r * 2) / 8;

  // Ribbons, not threads. Two near-parallel edges per arm is the cheapest
  // thing that reads as a ribbon and not as a tassel.
  const arm = (o: number) => {
    const sx = x + o * r;
    const dx = o * r * 0.9;
    const dy = r * 1.35;
    const seg = `c${n(dx * 0.2)} ${n(dy * 0.4)} ${n(dx * 0.7)} ${n(dy * 0.72)} ${n(dx)} ${n(dy)}`;
    return (
      `M${n(sx - r * 0.07)} ${n(y + r * 0.06)}${seg}` +
      `M${n(sx + r * 0.07)} ${n(y + r * 0.06)}${seg}`
    );
  };

  return {
    // A saucer, not a dome. Anything taller than about two thirds of its own
    // radius stops being a jellyfish and becomes an umbrella.
    bell: `M${n(x - r)} ${n(y)}A${n(r)} ${n(r * 0.66)} 0 0 1 ${n(x + r)} ${n(y)}`,
    rim:
      `M${n(x - r)} ${n(y)}` +
      Array(8).fill(`q${n(scallop / 2)} ${n(r * 0.15)} ${n(scallop)} 0`).join(''),
    gonads: [-0.5, -0.17, 0.17, 0.5]
      .map(
        (o) =>
          `M${n(x + o * r - r * 0.17)} ${n(y - r * 0.2)}a${n(r * 0.17)} ${n(r * 0.24)} 0 1 0 ${n(r * 0.34)} 0`,
      )
      .join(''),
    // Marginal tentacles: many, fine and uneven. Evenly spaced ticks of one
    // length read as a fringe sewn on.
    fringe: Array.from({ length: 25 }, (_, i) => {
      const f = i / 24;
      return `M${n(x - r + f * 2 * r)} ${n(y + r * 0.13 * Math.sin(f * Math.PI))}v${n(r * (0.14 + 0.22 * Math.abs(Math.sin(i * 2.1))))}`;
    }).join(''),
    arms: [-0.46, -0.16, 0.16, 0.46].map(arm).join(''),
  };
};

const JELLIES = [JELLY(40, 30, 20), JELLY(23, 94, 12), JELLY(55, 134, 9)];

// --- Contacts -------------------------------------------------------------
// mode  cross: enters one edge, leaves the other. rise: climbs out of frame.
//       hold: sits where it is put and fades again.
// react what a poke does. See the stylesheet for what each one looks like.
// vis   settled opacity. Depth reads as distance, so the deeper it lives the
//       fainter it is allowed to be.
const SPECIES = [
  { id: 'school', band: 'shallow', mode: 'cross', w: [190, 290], top: [14, 52], dur: [50, 76], vis: 0.34, react: 'flee', weight: 2 },
  { id: 'turtle', band: 'shallow', mode: 'cross', w: [110, 150], top: [18, 56], dur: [64, 92], vis: 0.3, react: 'flee', weight: 2 },
  { id: 'jellies', band: 'shallow', mode: 'rise', w: [76, 108], top: [0, 0], dur: [78, 118], vis: 0.26, react: 'pulse', weight: 2 },
  { id: 'sailfish', band: 'shallow', mode: 'cross', w: [240, 330], top: [16, 44], dur: [30, 46], vis: 0.24, react: 'flee', weight: 1 },
  { id: 'probe', band: 'shallow', mode: 'cross', w: [46, 62], top: [0, 0], dur: [86, 124], vis: 0.28, react: 'ping', weight: 1 },
  { id: 'towfish', band: 'shallow', mode: 'cross', w: [130, 176], top: [6, 24], dur: [62, 88], vis: 0.28, react: 'ping', weight: 1 },

  { id: 'oarfish', band: 'mid', mode: 'cross', w: [290, 430], top: [30, 58], dur: [108, 148], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'rov', band: 'mid', mode: 'cross', w: [150, 215], top: [40, 66], dur: [86, 120], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'thresher', band: 'mid', mode: 'cross', w: [230, 320], top: [20, 52], dur: [46, 70], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'glider', band: 'mid', mode: 'cross', w: [150, 205], top: [16, 42], dur: [70, 100], vis: 0.28, react: 'ping', weight: 2 },
  { id: 'squid', band: 'mid', mode: 'cross', w: [170, 240], top: [26, 60], dur: [54, 80], vis: 0.26, react: 'jet', weight: 2 },
  { id: 'whale', band: 'mid', mode: 'cross', w: [300, 420], top: [28, 60], dur: [100, 140], vis: 0.2, react: 'flee', weight: 1 },
  { id: 'argo', band: 'mid', mode: 'rise', w: [38, 54], top: [0, 0], dur: [92, 132], vis: 0.26, react: 'ping', weight: 1 },

  { id: 'angler', band: 'abyss', mode: 'cross', w: [160, 225], top: [24, 56], dur: [80, 116], vis: 0.24, react: 'lunge', weight: 2 },
  { id: 'sub', band: 'abyss', mode: 'cross', w: [190, 260], top: [34, 62], dur: [76, 108], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'barreleye', band: 'abyss', mode: 'cross', w: [130, 180], top: [22, 58], dur: [64, 92], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'tripod', band: 'abyss', mode: 'hold', w: [150, 210], top: [50, 68], left: [10, 62], dur: [56, 84], vis: 0.22, react: 'flee', weight: 2 },
  { id: 'colony', band: 'abyss', mode: 'rise', w: [40, 58], top: [0, 0], dur: [112, 160], vis: 0.2, react: 'pulse', weight: 2 },
  { id: 'wreck', band: 'abyss', mode: 'hold', w: [200, 300], top: [52, 68], left: [8, 62], dur: [58, 88], vis: 0.16, react: 'ping', weight: 1 },
  { id: 'vent', band: 'abyss', mode: 'hold', w: [150, 210], top: [46, 64], left: [6, 66], dur: [70, 104], vis: 0.18, react: 'ping', weight: 1 },
];
