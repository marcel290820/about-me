---
// Everything suspended in the deep water.
//
// Marine snow rides on this layer's own two pseudo-elements. The contacts are
// cloned out of the template library below, one at a time, by the script at the
// bottom of this file: which species, which lane, which way it is heading and
// how fast are all decided in the browser, so no two visits get the same water.
//
// Every figure in the library is drawn facing RIGHT. Heading is a scaleX on the
// body wrapper, which is the only reason nothing can ever swim backwards -- it
// is one rule in one place rather than a fact about twenty separate drawings.
//
// Drawn hairline and unfilled: the way a sounder or a field notebook records
// something rather than the way an illustration pictures it. Curved bodies come
// out of lib/curves, which explains why.
//
// Foam is telemetry and only telemetry. Buoy is the one warm mark.

import { type Node, spine, shell, ridge, rays } from '@/lib/curves';

// --- School ---------------------------------------------------------------
// Head at x=15, forked tail behind it. Small enough that anything more than a
// body and a tail turns to mud at the size these are actually seen.
const FISH =
  'M0 5C4 0.6 11 0.6 15 5C11 9.4 4 9.4 0 5ZM0 5-5.6 1-3.4 5-5.6 9Z';

const SCHOOL: [number, number, number][] = [
  [4, 16, 0.9],
  [30, 4, 0.78],
  [36, 29, 0.86],
  [66, 14, 1],
  [72, 34, 0.74],
  [104, 23, 0.7],
  [116, 6, 0.8],
];

// --- Oarfish --------------------------------------------------------------
// The longest bony fish there is: a silver ribbon that stands a scarlet crest
// over its head, and the reason sailors kept coming home reporting serpents.
const oar = spine({
  from: 20,
  to: 292,
  steps: 52,
  y: (t) => 52 + Math.sin((1 - t) * 7.4) * 7 + Math.sin((1 - t) * 15) * 2,
  up: [
    [0, 1],
    [0.2, 7],
    [0.5, 13],
    [0.78, 16],
    [0.92, 16.5],
    [1, 12],
  ],
  down: [
    [0, 1],
    [0.2, 7.5],
    [0.5, 13.5],
    [0.8, 16.5],
    [0.93, 15.5],
    [1, 10],
  ],
});

const oarFin = (p: Node) => 4 + Math.max(0, (p.t - 0.55) / 0.45) ** 1.3 * 34;
const oarHead = oar[oar.length - 1];

// --- Thresher shark -------------------------------------------------------
// The upper tail lobe is as long as the rest of the animal. It uses it to
// crack the water like a whip and stun what it is chasing.
const thresher = spine({
  from: 34,
  to: 226,
  y: (t) => 62 - Math.sin(t * 3.1) * 3,
  up: [
    [0, 1.4],
    [0.08, 5],
    [0.34, 14.5],
    [0.5, 15.5],
    [0.74, 12],
    [0.92, 5.5],
    [1, 0.8],
  ],
  down: [
    [0, 1.4],
    [0.08, 5],
    [0.36, 15.5],
    [0.54, 16],
    [0.78, 10],
    [0.94, 4.5],
    [1, 0.8],
  ],
});

// --- Sailfish -------------------------------------------------------------
const sail = spine({
  from: 30,
  to: 236,
  y: () => 66,
  up: [
    [0, 1],
    [0.06, 3.4],
    [0.3, 11],
    [0.52, 12],
    [0.8, 6.5],
    [0.94, 2.6],
    [1, 1.2],
  ],
  down: [
    [0, 1],
    [0.06, 3.6],
    [0.32, 12.5],
    [0.56, 12],
    [0.82, 6],
    [0.95, 2.4],
    [1, 1.2],
  ],
});

// The sail is the whole animal. It stands twice the body's depth and folds
// into a groove when the fish runs, which is why it gets its own curve.
const sailFin = (p: Node) =>
  Math.max(0, Math.sin(Math.min(1, Math.max(0, (p.t - 0.24) / 0.56)) * Math.PI)) ** 0.7 * 40;

// --- Sperm whale ----------------------------------------------------------
// A quarter of it is the case: a tank of oil it uses to focus the loudest
// sound any animal makes. Square on top, undercut below.
const whale = spine({
  from: 44,
  to: 268,
  y: (t) => 62 - t * 5,
  up: [
    [0, 2],
    [0.08, 6],
    [0.34, 18],
    [0.6, 22],
    [0.72, 23.5],
    [0.95, 23.5],
    [1, 15],
  ],
  down: [
    [0, 2],
    [0.08, 6],
    [0.36, 17],
    [0.62, 17],
    [0.76, 14],
    [0.9, 9],
    [1, 3],
  ],
});

// --- Anglerfish -----------------------------------------------------------
// The body stops at the jaw hinge. Both jaws are drawn from there as their own
// shapes, because a gape that is only teeth painted onto a silhouette reads as
// a smile rather than as a mouth that opens.
const angler = spine({
  from: 18,
  to: 124,
  y: () => 64,
  up: [
    [0, 1.4],
    [0.12, 5],
    [0.36, 17],
    [0.64, 28],
    [0.86, 31],
    [1, 26],
  ],
  down: [
    [0, 1.4],
    [0.12, 5],
    [0.36, 18],
    [0.64, 30],
    [0.86, 30],
    [1, 24],
  ],
});

/** Teeth stood on a jaw line, so they sit on it rather than near it. */
function teeth(
  x0: number,
  y0: number,
  x1: number,
  y1: number,
  n: number,
  len: number,
  dir: number,
) {
  return Array.from({ length: n }, (_, i) => {
    const t = (i + 0.5) / n;
    const x = x0 + (x1 - x0) * t;
    const y = y0 + (y1 - y0) * t;
    const l = len * (0.55 + 0.75 * Math.sin(t * Math.PI));
    return `M${(x - 3.2).toFixed(1)} ${y.toFixed(1)}L${(x + 1.4).toFixed(1)} ${(y + dir * l).toFixed(1)}L${(x + 3.2).toFixed(1)} ${y.toFixed(1)}`;
  }).join('');
}

// --- Barreleye ------------------------------------------------------------
// The two spots on the front of its face are nostrils. The eyes are the green
// barrels inside the transparent head, and they are pointed straight up.
const barrel = spine({
  from: 16,
  to: 124,
  y: () => 54,
  up: [
    [0, 1],
    [0.12, 4],
    [0.44, 11],
    [0.7, 12.5],
    [0.9, 10],
    [1, 6.5],
  ],
  down: [
    [0, 1],
    [0.12, 4],
    [0.44, 12],
    [0.72, 12.5],
    [0.9, 9],
    [1, 5],
  ],
});

// --- Tripod fish ----------------------------------------------------------
// Stands on three stiffened fin rays, facing into the current, and waits.
// Nearly blind; the two long pectoral rays held out in front are how it finds
// anything at all.
const tripod = spine({
  from: 32,
  to: 152,
  y: () => 44,
  steps: 32,
  up: [
    [0, 1],
    [0.1, 4],
    [0.42, 9],
    [0.72, 8],
    [0.9, 5],
    [1, 1.6],
  ],
});

// --- Squid ----------------------------------------------------------------
// Jets apex first, arms streaming behind, which is the shape it makes when it
// is going somewhere rather than hunting.
const squid = spine({
  from: 74,
  to: 176,
  y: () => 48,
  up: [
    [0, 12],
    [0.22, 14.5],
    [0.58, 11],
    [0.86, 4.5],
    [1, 0.6],
  ],
});

// Eight arms, then the two long tentacles that do the catching.
const ARMS = [
  'M74 40C58 34 40 33 22 38',
  'M74 43C58 40 38 42 24 48',
  'M74 46C56 47 38 52 26 58',
  'M74 50C58 54 42 62 32 68',
  'M74 53C60 60 48 70 42 78',
  'M74 56C64 64 58 74 56 84',
];
const TENTACLES = ['M74 44C48 36 20 30-8 32', 'M74 52C50 56 22 66 0 74'];

// --- Turtle ---------------------------------------------------------------
const shellNodes = spine({
  from: 14,
  to: 100,
  y: () => 46,
  up: [
    [0, 1.5],
    [0.14, 13],
    [0.48, 19],
    [0.84, 13.5],
    [1, 2.5],
  ],
  down: [
    [0, 1.5],
    [0.16, 6],
    [0.5, 8],
    [0.84, 6],
    [1, 2.5],
  ],
});

// --- Hulls ----------------------------------------------------------------
// Three built things share one profile family: a pressure hull is a pressure
// hull whether it is towed, flown or crewed.
const torpedo = (from: number, to: number, y: number, r: number) =>
  spine({
    from,
    to,
    y: () => y,
    steps: 30,
    up: [
      [0, r * 0.34],
      [0.16, r * 0.9],
      [0.62, r],
      [0.9, r * 0.86],
      [1, r * 0.2],
    ],
  });

const towHull = shell(torpedo(30, 132, 34, 11));
const gliderHull = shell(torpedo(26, 148, 38, 9));
const subHull = shell(
  spine({
    from: 26,
    to: 168,
    y: () => 56,
    steps: 34,
    up: [
      [0, 4],
      [0.14, 15],
      [0.5, 19],
      [0.82, 18],
      [1, 8],
    ],
    down: [
      [0, 4],
      [0.14, 14],
      [0.5, 17],
      [0.82, 16],
      [1, 8],
    ],
  }),
);

// --- Siphonophore ---------------------------------------------------------
// A colony, not an animal: a gas float at the top, a stack of swimming bells
// under it that beat together, then metres of feeding stem.
const BELLS: [number, number, number][] = [
  [26, 30, 1],
  [31, 54, 0.94],
  [22, 78, 0.88],
  [30, 102, 0.8],
  [23, 126, 0.72],
  [29, 150, 0.64],
  [24, 174, 0.56],
];
const BELL = 'M-10 4-5.5-11H5.5L10 4Q0 10-10 4Z';

// --- Moon jellies ---------------------------------------------------------
// Four horseshoes in the bell are the gonads, and they are the only reliable
// way to tell a moon jelly from every other bell in the water.
// Authored at final size rather than drawn once and scaled, so the hairline
// stays a hairline whichever bell it belongs to.
const JELLY = (x: number, y: number, r: number) => {
  const n = (v: number) => v.toFixed(1);
  const step = (r * 2) / 5;
  return {
    bell: `M${n(x - r)} ${n(y)}A${n(r)} ${n(r * 0.84)} 0 0 1 ${n(x + r)} ${n(y)}`,
    rim:
      `M${n(x - r)} ${n(y)}` +
      Array(5).fill(`q${n(step / 2)} ${n(r * 0.3)} ${n(step)} 0`).join(''),
    gonads: [-0.54, -0.18, 0.18, 0.54]
      .map(
        (o) =>
          `M${n(x + o * r - r * 0.14)} ${n(y - r * 0.34)}a${n(r * 0.14)} ${n(r * 0.2)} 0 1 0 ${n(r * 0.28)} 0`,
      )
      .join(''),
    fringe: Array.from({ length: 11 }, (_, i) =>
      `M${n(x - r + (i * 2 * r) / 10)} ${n(y + r * 0.05)}v${n(r * 0.3)}`,
    ).join(''),
    arms: [-0.4, -0.14, 0.14, 0.4]
      .map(
        (o) =>
          `M${n(x + o * r)} ${n(y + r * 0.14)}c${n(o * r * 0.25)} ${n(r * 0.5)} ${n(o * r * 0.45)} ${n(r * 0.95)} ${n(o * r * 0.6)} ${n(r * 1.4)}`,
      )
      .join(''),
  };
};

const JELLIES = [JELLY(40, 30, 19), JELLY(24, 92, 12), JELLY(54, 130, 9)];

// --- Contacts -------------------------------------------------------------
// mode  cross: enters one edge, leaves the other. rise: climbs out of frame.
//       hold: sits where it is put and fades again.
// react what a poke does. See the stylesheet for what each one looks like.
// vis   settled opacity. Depth reads as distance, so the deeper it lives the
//       fainter it is allowed to be.
const SPECIES = [
  { id: 'school', band: 'shallow', mode: 'cross', w: [190, 290], top: [14, 52], dur: [50, 76], vis: 0.34, react: 'flee', weight: 3 },
  { id: 'turtle', band: 'shallow', mode: 'cross', w: [110, 150], top: [18, 56], dur: [64, 92], vis: 0.3, react: 'flee', weight: 2 },
  { id: 'jellies', band: 'shallow', mode: 'rise', w: [76, 108], top: [0, 0], dur: [78, 118], vis: 0.26, react: 'pulse', weight: 2 },
  { id: 'sailfish', band: 'shallow', mode: 'cross', w: [240, 330], top: [16, 44], dur: [30, 46], vis: 0.24, react: 'flee', weight: 1 },
  { id: 'probe', band: 'shallow', mode: 'cross', w: [46, 62], top: [0, 0], dur: [86, 124], vis: 0.28, react: 'ping', weight: 1 },
  { id: 'towfish', band: 'shallow', mode: 'cross', w: [130, 176], top: [6, 24], dur: [62, 88], vis: 0.28, react: 'ping', weight: 1 },

  { id: 'oarfish', band: 'mid', mode: 'cross', w: [290, 430], top: [30, 58], dur: [108, 148], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'rov', band: 'mid', mode: 'cross', w: [150, 215], top: [40, 66], dur: [86, 120], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'thresher', band: 'mid', mode: 'cross', w: [230, 320], top: [20, 52], dur: [46, 70], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'glider', band: 'mid', mode: 'cross', w: [150, 205], top: [16, 42], dur: [70, 100], vis: 0.28, react: 'ping', weight: 2 },
  { id: 'squid', band: 'mid', mode: 'cross', w: [170, 240], top: [26, 60], dur: [54, 80], vis: 0.26, react: 'jet', weight: 2 },
  { id: 'whale', band: 'mid', mode: 'cross', w: [300, 420], top: [28, 60], dur: [100, 140], vis: 0.2, react: 'flee', weight: 1 },
  { id: 'argo', band: 'mid', mode: 'rise', w: [38, 54], top: [0, 0], dur: [92, 132], vis: 0.26, react: 'ping', weight: 1 },

  { id: 'angler', band: 'abyss', mode: 'cross', w: [160, 225], top: [24, 56], dur: [80, 116], vis: 0.24, react: 'lunge', weight: 2 },
  { id: 'sub', band: 'abyss', mode: 'cross', w: [190, 260], top: [34, 62], dur: [76, 108], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'barreleye', band: 'abyss', mode: 'cross', w: [130, 180], top: [22, 58], dur: [64, 92], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'tripod', band: 'abyss', mode: 'hold', w: [150, 210], top: [50, 68], left: [10, 62], dur: [56, 84], vis: 0.22, react: 'flee', weight: 2 },
  { id: 'colony', band: 'abyss', mode: 'rise', w: [40, 58], top: [0, 0], dur: [112, 160], vis: 0.2, react: 'pulse', weight: 2 },
  { id: 'wreck', band: 'abyss', mode: 'hold', w: [200, 300], top: [52, 68], left: [8, 62], dur: [58, 88], vis: 0.16, react: 'ping', weight: 1 },
  { id: 'vent', band: 'abyss', mode: 'hold', w: [150, 210], top: [46, 64], left: [6, 66], dur: [70, 104], vis: 0.18, react: 'ping', weight: 1 },
];
---

<div class="drift" data-drift aria-hidden="true"></div>

{/* The library. Templates are inert until something clones one, so all of
    this costs markup and nothing else. */}

{/* --- Shallow: light still reaches, so things here are quick and legible. */}

<template data-species="school">
  <svg viewBox="-10 -6 152 48" fill="none" stroke="currentColor" stroke-width="1">
    {SCHOOL.map(([x, y, s]) => (
      <path d={FISH} transform={`translate(${x} ${y}) scale(${s})`} />
    ))}
    {/* The one that got caught, measured and let go again. An acoustic tag is
        real field kit, and it is the only thing down here still reporting. */}
    <g transform="translate(84 12) scale(1.25)">
      <path d={FISH} />
      <path d="M4.6 1.1h6.2v2.7H4.6z" stroke-width="0.7" />
      <path d="M10.8 1.1 15-3.4" stroke-width="0.7" />
      <path d="M15.4-5.6a4.6 4.6 0 0 1 2.8 3.6" class="drift__ping" />
      <path d="M17.2-8.2a7.8 7.8 0 0 1 4.7 6" class="drift__ping drift__ping--late" />
      <circle cx="7.7" cy="2.4" r="1" fill="currentColor" class="drift__telemetry" />
    </g>
  </svg>
</template>

<template data-species="turtle">
  <svg viewBox="0 0 132 92" fill="none" stroke="currentColor" stroke-width="1">
    <path d={shell(shellNodes)} />
    {/* Scutes. A loggerhead carries five down the midline. */}
    <path d="M32 28v25M50 25v29M68 26v28M86 30v22" stroke-width="0.5" opacity="0.7" />
    <path d="M16 43C40 36 76 36 98 43" stroke-width="0.5" opacity="0.7" />
    {/* Short neck, wedge head, hooked beak. A loggerhead is mostly head. */}
    <path d="M99 37c2 0 4-1 5-2M100 45c2 0 4-1 6-2" stroke-width="0.7" />
    <path d="M104 43c-1-8 4-13 11-13 6 0 10 3 11 6 1 3-2 6-5 7-6 2-13 2-17 0Z" />
    <path d="M126 36c2 2 2 4 0 6" stroke-width="0.6" />
    <circle cx="114" cy="36" r="1.2" fill="currentColor" />
    {/* Front flipper on the downstroke, rear one trailing. */}
    <path d="M76 52c12 8 16 24 10 36-10-6-14-22-13-34Z" stroke-width="0.8" />
    <path d="M30 51c-2 10-9 17-19 19 1-10 7-16 14-19Z" stroke-width="0.8" />
  </svg>
</template>

<template data-species="jellies">
  <svg viewBox="0 0 80 176" fill="none" stroke="currentColor" stroke-width="0.9">
    {JELLIES.map((j) => (
      <g>
        <path d={j.bell} />
        <path d={j.rim} stroke-width="0.6" />
        <path d={j.gonads} stroke-width="0.6" opacity="0.8" />
        <path d={j.fringe} stroke-width="0.4" opacity="0.55" />
        <path d={j.arms} stroke-width="0.5" opacity="0.75" />
      </g>
    ))}
  </svg>
</template>

<template data-species="sailfish">
  <svg viewBox="0 -4 306 116" fill="none" stroke="currentColor" stroke-width="1">
    <path d={shell(sail)} />
    <path d={ridge(sail, sailFin)} stroke-width="0.5" opacity="0.75" />
    <path d={rays(sail, sailFin, 2, 0.24)} stroke-width="0.5" opacity="0.6" />
    {/* Bill: a third of the length again, and the reason it can outrun almost
        anything it shares water with. */}
    <path d="M234 65 300 62 234 68Z" />
    <path d="M30 66-2 44l14 22-14 22Z" />
    <path d="M118 78c-2 16-6 26-14 32M124 78c-1 17-4 28-10 35" stroke-width="0.5" opacity="0.7" />
    <path d="M186 76c8 10 10 20 8 28" stroke-width="0.6" opacity="0.8" />
    <circle cx="222" cy="61" r="2.2" stroke-width="0.7" />
    <path d="M204 52c6 6 10 12 12 20" stroke-width="0.5" opacity="0.6" />
  </svg>
</template>

<template data-species="probe">
  <svg viewBox="0 0 72 300" fill="none" stroke="currentColor" stroke-width="1">
    {/* The wire is the one vertical line in the whole layer, and a vertical
        hairline through a paragraph reads as a rendering fault rather than as
        rigging. Held well under the instrument's weight. */}
    <path d="M36 0v236" stroke-width="0.6" opacity="0.45" />
    <path d="M20 248 36 236l16 12" stroke-width="0.7" />
    <path d="M16 248h40l-5 44H21z" />
    <path d="M25 254v34M36 252v38M47 254v34" stroke-width="0.6" />
    <path d="M19 266h34M20 278h32" stroke-width="0.6" />
    <path d="M36 292v8" />
    <circle cx="36" cy="298" r="2" fill="currentColor" class="drift__telemetry" />
    <circle cx="36" cy="270" r="14" class="drift__ring" />
  </svg>
  <span class="drift__tag">CTD 03</span>
</template>

<template data-species="towfish">
  <svg viewBox="-6 0 160 108" fill="none" stroke="currentColor" stroke-width="1">
    {/* Towed on a warp that runs up to a ship you cannot see. */}
    <path d="M34 28C22 18 12 10 0 4" stroke-width="0.6" opacity="0.5" />
    <path d="M34 28 40 34" stroke-width="0.7" />
    <path d={towHull} />
    <path d="M40 26v16M52 24v20" stroke-width="0.5" opacity="0.6" />
    <path d="M36 24 26 12h9l7 10M36 44 26 56h9l7-10" stroke-width="0.7" />
    <circle cx="118" cy="34" r="2.4" stroke-width="0.7" />
    {/* Two side-scan fans. The picture it is making is the point of it. */}
    <path d="M76 45 44 104M76 45 96 104" stroke-width="0.5" stroke-dasharray="2 4" opacity="0.55" />
    <path d="M50 96 92 96" stroke-width="0.5" stroke-dasharray="1 3" opacity="0.4" />
    <circle cx="76" cy="34" r="1.6" fill="currentColor" class="drift__telemetry" />
    <circle cx="76" cy="34" r="22" class="drift__ring" />
  </svg>
  <span class="drift__tag">SSS 400 kHz</span>
</template>

{/* --- Mid: blue water. Big, slow and mostly silhouette. */}

<template data-species="oarfish">
  <svg viewBox="0 -20 316 158" fill="none" stroke="currentColor" stroke-width="1">
    <path d={shell(oar)} />
    <path d={ridge(oar, oarFin)} stroke-width="0.5" opacity="0.7" />
    <path d={rays(oar, oarFin, 3, 0)} stroke-width="0.5" opacity="0.65" />
    {/* The crest is a mane of the first dorsal rays, and on a live one it is
        scarlet. Buoy is the one warm mark down here. */}
    <path d={rays(oar, oarFin, 2, 0.8)} stroke-width="0.9" class="drift__crest" />
    {/* The face is near vertical, and the mouth shoots forward off it to feed. */}
    <circle cx={oarHead.x - 12} cy={oarHead.y - 4} r="3.4" stroke-width="0.7" />
    <path d={`M${oarHead.x - 2} ${oarHead.y + 1}h-11M${oarHead.x - 4} ${oarHead.y + 7}c6 0 8-3 8-6`} stroke-width="0.6" />
    <path d={`M${oarHead.x - 30} ${oarHead.y - 13}c8 5 13 10 15 17`} stroke-width="0.5" opacity="0.5" />
    {/* Two pelvic fins trail like oars, which is where the name comes from. */}
    <path d="M260 76c-10 22-32 34-56 35M252 77c-8 26-30 42-54 44" stroke-width="0.5" opacity="0.8" />
    <path d="M204 111c-5 1-8 6-6 10 5-1 8-6 6-10ZM199 120c-5 1-8 6-6 10 5-1 8-6 6-10Z" stroke-width="0.5" opacity="0.8" />
  </svg>
</template>

<template data-species="rov">
  <svg viewBox="-8 0 176 116" fill="none" stroke="currentColor" stroke-width="1">
