---
// Everything suspended in the deep water.
//
// Marine snow rides on this layer's own two pseudo-elements. The contacts are
// cloned out of the template library below, one at a time, by the script at the
// bottom of this file: which species, which lane, which way it is heading and
// how fast are all decided in the browser, so no two visits get the same water.
//
// Every figure in the library is drawn facing RIGHT. Heading is a scaleX on the
// body wrapper, which is the only reason nothing can ever swim backwards -- it
// is one rule in one place rather than a fact about twenty separate drawings.
//
// Drawn hairline and unfilled: the way a sounder or a field notebook records
// something rather than the way an illustration pictures it. Curved bodies come
// out of lib/curves, which explains why.
//
// Foam is telemetry and only telemetry. Buoy is the one warm mark.

import School from '@/components/figures/School.astro';
import Turtle from '@/components/figures/Turtle.astro';
import Jellies from '@/components/figures/Jellies.astro';
import Sailfish from '@/components/figures/Sailfish.astro';
import Probe from '@/components/figures/Probe.astro';
import Towfish from '@/components/figures/Towfish.astro';
import Oarfish from '@/components/figures/Oarfish.astro';
import Rov from '@/components/figures/Rov.astro';
import Thresher from '@/components/figures/Thresher.astro';
import Glider from '@/components/figures/Glider.astro';
import Squid from '@/components/figures/Squid.astro';
import Whale from '@/components/figures/Whale.astro';
import Argo from '@/components/figures/Argo.astro';
import Angler from '@/components/figures/Angler.astro';
import Sub from '@/components/figures/Sub.astro';
import Barreleye from '@/components/figures/Barreleye.astro';
import Tripod from '@/components/figures/Tripod.astro';
import Colony from '@/components/figures/Colony.astro';
import Wreck from '@/components/figures/Wreck.astro';
import Vent from '@/components/figures/Vent.astro';

// --- Contacts -------------------------------------------------------------
// mode  cross: enters one edge, leaves the other. rise: climbs out of frame.
//       hold: sits where it is put and fades again.
// react what a poke does. See the stylesheet for what each one looks like.
// vis   settled opacity. Depth reads as distance, so the deeper it lives the
//       fainter it is allowed to be.
const SPECIES = [
  { id: 'school', band: 'shallow', mode: 'cross', w: [190, 290], top: [14, 52], dur: [50, 76], vis: 0.34, react: 'flee', weight: 2 },
  { id: 'turtle', band: 'shallow', mode: 'cross', w: [110, 150], top: [18, 56], dur: [64, 92], vis: 0.3, react: 'flee', weight: 2 },
  { id: 'jellies', band: 'shallow', mode: 'rise', w: [88, 124], top: [0, 0], dur: [78, 118], vis: 0.26, react: 'pulse', weight: 2 },
  { id: 'sailfish', band: 'shallow', mode: 'cross', w: [240, 330], top: [16, 44], dur: [30, 46], vis: 0.24, react: 'flee', weight: 1 },
  { id: 'probe', band: 'shallow', mode: 'cross', w: [58, 76], top: [0, 0], dur: [86, 124], vis: 0.28, react: 'ping', weight: 1 },
  { id: 'towfish', band: 'shallow', mode: 'cross', w: [150, 200], top: [6, 24], dur: [62, 88], vis: 0.28, react: 'ping', weight: 1 },

  { id: 'oarfish', band: 'mid', mode: 'cross', w: [330, 490], top: [30, 58], dur: [108, 148], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'rov', band: 'mid', mode: 'cross', w: [165, 235], top: [40, 66], dur: [86, 120], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'thresher', band: 'mid', mode: 'cross', w: [290, 400], top: [20, 52], dur: [46, 70], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'glider', band: 'mid', mode: 'cross', w: [190, 255], top: [16, 42], dur: [70, 100], vis: 0.28, react: 'ping', weight: 2 },
  { id: 'squid', band: 'mid', mode: 'cross', w: [170, 240], top: [26, 60], dur: [54, 80], vis: 0.26, react: 'jet', weight: 2 },
  { id: 'whale', band: 'mid', mode: 'cross', w: [300, 420], top: [28, 60], dur: [100, 140], vis: 0.2, react: 'flee', weight: 1 },
  { id: 'argo', band: 'mid', mode: 'rise', w: [38, 54], top: [0, 0], dur: [92, 132], vis: 0.26, react: 'ping', weight: 1 },

  { id: 'angler', band: 'abyss', mode: 'cross', w: [160, 225], top: [24, 56], dur: [80, 116], vis: 0.24, react: 'lunge', weight: 2 },
  { id: 'sub', band: 'abyss', mode: 'cross', w: [190, 260], top: [34, 62], dur: [76, 108], vis: 0.3, react: 'ping', weight: 2 },
  { id: 'barreleye', band: 'abyss', mode: 'cross', w: [130, 180], top: [22, 58], dur: [64, 92], vis: 0.24, react: 'flee', weight: 2 },
  { id: 'tripod', band: 'abyss', mode: 'hold', w: [150, 210], top: [50, 68], left: [10, 62], dur: [56, 84], vis: 0.22, react: 'flee', weight: 2 },
  { id: 'colony', band: 'abyss', mode: 'rise', w: [40, 58], top: [0, 0], dur: [112, 160], vis: 0.2, react: 'pulse', weight: 2 },
  { id: 'wreck', band: 'abyss', mode: 'hold', w: [200, 300], top: [52, 68], left: [8, 62], dur: [58, 88], vis: 0.16, react: 'ping', weight: 1 },
  { id: 'vent', band: 'abyss', mode: 'hold', w: [150, 210], top: [46, 64], left: [6, 66], dur: [70, 104], vis: 0.18, react: 'ping', weight: 1 },
];
---

<div class="drift" data-drift aria-hidden="true"></div>

{/* The library. Templates are inert until something clones one, so all of
    this costs markup and nothing else. */}

{/* --- Shallow: light still reaches, so things here are quick and legible. */}

<template data-species="school"><School /></template>
<template data-species="turtle"><Turtle /></template>
<template data-species="jellies"><Jellies /></template>
<template data-species="sailfish"><Sailfish /></template>
<template data-species="probe"><Probe /></template>
<template data-species="towfish"><Towfish /></template>

{/* --- Mid: blue water. Big, slow and mostly silhouette. */}

<template data-species="oarfish"><Oarfish /></template>
<template data-species="rov"><Rov /></template>
<template data-species="thresher"><Thresher /></template>
<template data-species="glider"><Glider /></template>
<template data-species="squid"><Squid /></template>
<template data-species="whale"><Whale /></template>
<template data-species="argo"><Argo /></template>

{/* --- Abyss: no light at all, so everything here either makes its own or is
    only ever a return on a screen. */}

<template data-species="angler"><Angler /></template>
<template data-species="sub"><Sub /></template>
<template data-species="barreleye"><Barreleye /></template>
<template data-species="tripod"><Tripod /></template>
<template data-species="colony"><Colony /></template>
<template data-species="wreck"><Wreck /></template>
<template data-species="vent"><Vent /></template>

<script define:vars={{ SPECIES }}>
  const root = document.documentElement;
  const layer = document.querySelector('[data-drift]');

  // Asked for no motion, so there is nothing swimming past and no reason to
  // run any of this.
  if (layer && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const rnd = (a, b) => a + Math.random() * (b - a);
    const narrow = () => innerWidth < 760;

    // One flat bag per band, species repeated by weight, so picking is a
    // single index. Rebuilt never: the table is static.
    const BANDS = {};
    for (const s of SPECIES) {
      (BANDS[s.band] ||= []).push(...Array(s.weight).fill(s));
    }

    const live = [];
    // The last few species seen, so a contact that just left cannot be the
    // next one in. Live-only exclusion let the school swim out and straight
    // back in, which reads as one fish on a loop rather than a sea.
    const recent = [];
    const REMEMBER = 3;
    let band = root.dataset.depth;

    function despawn(c) {
      const i = live.indexOf(c);
      if (i > -1) live.splice(i, 1);
      c.el.style.opacity = '0';
      setTimeout(() => c.el.remove(), 1500);
    }

    // `seeded` starts the contact partway through its crossing instead of at
    // the edge, so it is already in frame. See stock() for why that matters.
    function spawn(seeded) {
      // Never two of the same thing at once. Twenty species and a cap of two
      // in frame means a repeat reads as a glitch rather than as a shoal.
      const here = (BANDS[band] || []).filter(
        (s) => !live.some((c) => c.sp.id === s.id),
      );
      // Prefer what has not been seen lately; fall back to anything not live
      // when a band is too small to have anything fresh left.
      const fresh = here.filter((s) => !recent.includes(s.id));
      const bag = fresh.length ? fresh : here;
      if (!bag.length) return;
      const sp = bag[(Math.random() * bag.length) | 0];
      recent.push(sp.id);
      if (recent.length > REMEMBER) recent.shift();
      const tpl = document.querySelector(`template[data-species="${sp.id}"]`);
      if (!tpl) return;

      // Keep lanes apart, or two contacts sit at the same height and read as
      // one cluttered event instead of two sightings. Risers are exempt both
      // ways: they pass through every lane there is.
      let top = rnd(sp.top[0], sp.top[1]);
      if (sp.mode !== 'rise') {
        const taken = live.filter((c) => c.mode !== 'rise');
        // Keep the roomiest draw rather than the last one. Where two species
        // share most of their band, giving up on the final try and using
        // whatever it happened to be lands them in the same lane.
        let best = -1;
        for (let i = 0; i < 8; i++) {
          const t = rnd(sp.top[0], sp.top[1]);
          const gap = taken.length
            ? Math.min(...taken.map((c) => Math.abs(c.top - t)))
            : Infinity;
          if (gap > best) {
            best = gap;
            top = t;
          }
          if (gap >= 15) break;
        }
      }

      const el = document.createElement('div');
      el.className = `drift__figure drift__figure--${sp.id}`;
      el.style.top = `${top}%`;
      // Contacts hold their drawn size on a phone rather than scaling with the
      // viewport, or a whale on a 380px screen is the whole screen.
      el.style.width = `${rnd(sp.w[0], sp.w[1]) * Math.min(1.12, Math.max(0.58, innerWidth / 1280))}px`;

      const body = document.createElement('div');
      body.className = 'drift__body';
      // Every figure is drawn facing right, and this is the one place heading
      // is decided -- for the things that stand still as much as for the
      // things that cross. A tripod fish that always faced right was a tell.
      const heading = Math.random() < 0.5 ? 1 : -1;
      body.style.setProperty('--flip', heading);
      // Anything alive breathes: a slow bob on the drawing, on its own clock,
      // so no two are in step. Machines hold their trim.
      if (sp.react !== 'ping') {
        el.classList.add('is-alive');
        el.style.setProperty('--bob-t', `${rnd(5.5, 9.5).toFixed(1)}s`);
        el.style.setProperty('--bob-d', `${(-rnd(0, 9)).toFixed(1)}s`);
      }

      const frag = tpl.content.cloneNode(true);
      body.appendChild(frag.querySelector('svg'));
      el.appendChild(body);
      // The tag is printed, not swum, so it stays outside the flip.
      const tag = frag.querySelector('.drift__tag');
      if (tag) el.appendChild(tag);

      const dur = rnd(sp.dur[0], sp.dur[1]);
      // A negative delay starts the animation already run that far. The
      // fractions are the part of each keyframe that is actually on screen:
      // a crossing spends its first quarter out beyond the left edge.
      const lead = (a, b) => (seeded ? `${(-dur * rnd(a, b)).toFixed(1)}s` : '0s');

      if (sp.mode === 'cross') {
        // Not on rails: each crossing climbs or dives a little over its run.
        // A straight line at one height is how a conveyor moves, not a fish.
        el.style.setProperty('--dy', `${rnd(-11, 11).toFixed(1)}vh`);
        el.style.animation = `drift-cross-${heading > 0 ? 'r' : 'l'} ${dur}s linear ${lead(0.3, 0.78)} 1 forwards`;
      } else if (sp.mode === 'rise') {
        el.style.left = `${rnd(8, 78)}%`;
        // Risers lean with whatever current there is, either way.
        el.style.setProperty('--dx', `${rnd(-10, 10).toFixed(1)}vw`);
        el.style.animation = `drift-rise ${dur}s linear ${lead(0.12, 0.46)} 1 forwards`;
      } else {
        el.style.left = `${rnd(sp.left[0], sp.left[1])}%`;
      }

      layer.appendChild(el);
      const c = { el, body, sp, top, mode: sp.mode, poked: 0 };
      live.push(c);

      // Two frames: one for the browser to accept the element at opacity 0,
      // one for the transition to have something to run from.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          el.style.opacity = sp.vis;
        }),
      );

      if (sp.mode === 'hold') {
        c.timer = setTimeout(() => despawn(c), dur * 1000);
      } else {
        el.addEventListener('animationend', (e) => {
          if (e.target === el) despawn(c);
        });
      }
    }

    // Arriving somewhere in the sea should show you what lives there. Waiting
    // for the chain instead put every band's first contact up to nine seconds
    // out, and a crossing then spends another quarter of its run off the edge
    // before it is visible at all -- so a band you scrolled into was reliably
    // empty for half a minute, and everything appeared to start at whatever
    // scroll height you happened to stop at. Stock it on arrival, seeded, and
    // let the chain take over from there.
    //
    // Two at a time, one on a phone. Three read as a crowd: the water is meant
    // to be mostly empty, and a sighting only counts as one if it is alone.
    const cap = () => (narrow() ? 1 : 2);

    function stock() {
      for (let i = 0; i < cap(); i++) {
        setTimeout(() => {
          if (!document.hidden && band && band !== 'dry' && live.length < cap()) {
            spawn(true);
          }
        }, i * 380);
      }
    }

    // Spawning is a chain rather than an interval, so a hidden tab or a dry
    // page cannot build up a backlog of contacts to release at once.
    (function next() {
      setTimeout(() => {
        if (!document.hidden && band && band !== 'dry' && live.length < cap()) {
          spawn();
        }
        next();
      }, rnd(5200, 13000));
    })();

    // Which band is in the frame is written on <html> by the layout. Anything
    // left over from the band above swims out rather than snapping off.
    new MutationObserver(() => {
      if (root.dataset.depth === band) return;
      band = root.dataset.depth;
      for (const c of live.slice()) {
        if (c.sp.band !== band) despawn(c);
      }
      stock();
    }).observe(root, { attributes: true, attributeFilter: ['data-depth'] });

    // Loading straight into a band -- a deep link, or a restored scroll
    // position -- is an arrival too.
    stock();

    // --- Poking -----------------------------------------------------------
    // The layer takes no pointer events and sits behind every word, so this is
    // proximity rather than hit testing: brush past something while reading
    // and it notices. Rects are only read when the pointer actually moves.
    let px = 0;
    let py = 0;
    let queued = false;

    // The surface register is drawn once and moored, so it never spawns and
    // never appears in `live` -- but it is in the same water and answers a
    // poke the same way, off the same markup contract.
    //
    // Collected on the first poke rather than at startup: define:vars makes
    // this script inline, so it runs where it sits in the document and the
    // register further down does not exist yet.
    let moored = null;

    function scan() {
      queued = false;
      const now = performance.now();
      moored ??= [...document.querySelectorAll('[data-poke]')].map((el) => ({
        el,
        body: el.querySelector('.drift__body'),
        sp: { react: el.dataset.poke },
        poked: 0,
      }));
      for (const c of live) probe(c, now);
      for (const c of moored) probe(c, now);
    }

    function probe(c, now) {
      if (now - c.poked < 2600) return;
      const r = c.el.getBoundingClientRect();
      if (!r.width) return;
      const dx = px - (r.left + r.width / 2);
      const dy = py - (r.top + r.height / 2);
      // Against the figure's own box rather than a circle round it, or a
      // 40px probe on a 300px wire answers from halfway across the page.
      const ex = dx / (r.width / 2 + 26);
      const ey = dy / (r.height / 2 + 26);
      if (ex * ex + ey * ey > 1) return;
      c.poked = now;
      react(c, dx, dy);
    }

    function react(c, dx, dy) {
      const away = c.sp.react === 'lunge' ? 1 : -1;
      const len = Math.hypot(dx, dy) || 1;
      const nx = (dx / len) * away;
      const ny = (dy / len) * away;
      const s = c.body.style;

      if (c.sp.react === 'flee' || c.sp.react === 'jet' || c.sp.react === 'lunge') {
        const kick = c.sp.react === 'jet' ? 96 : c.sp.react === 'lunge' ? 34 : 66;
        s.setProperty('--fx', `${(nx * kick).toFixed(0)}px`);
        s.setProperty('--fy', `${(ny * kick * 0.62).toFixed(0)}px`);
        s.setProperty('--fr', `${(ny * 9).toFixed(1)}deg`);
      } else if (c.sp.react === 'pulse') {
        // A bell does not dodge. It contracts, and that throws it upward.
        s.setProperty('--fy', '-54px');
        s.setProperty('--fs', '0.86');
      }

      c.el.classList.add('is-poked');
      clearTimeout(c.release);
      c.release = setTimeout(() => {
        c.el.classList.remove('is-poked');
        s.removeProperty('--fx');
        s.removeProperty('--fy');
        s.removeProperty('--fr');
        s.removeProperty('--fs');
      }, 760);
    }

    addEventListener(
      'pointermove',
      (e) => {
        px = e.clientX;
        py = e.clientY;
        if (!queued) {
          queued = true;
          requestAnimationFrame(scan);
        }
      },
      { passive: true },
    );
  }
</script>
