---
// The single crossing from chart paper into deep water.
//
// Two swell trains travel across it at different speeds. Where their crests
// meet the water stands higher, and because the periods do not divide evenly
// that beat never lines up the same way twice, which is what stops it reading
// as a looping banner.
//
// Each profile is a sum of sines with INTEGER wave numbers over the tile, so
// y(0) === y(TILE) by construction and the repeat cannot seam. Two tiles are
// drawn side by side and the layer travels exactly one tile per cycle.
const TILE = 1200;
const STEPS = 60;

type Harmonic = [waveNumber: number, amplitude: number, phase: number];

function train(mid: number, harmonics: Harmonic[]) {
  const points: string[] = [];
  for (let i = 0; i <= STEPS * 2; i++) {
    const t = (i / STEPS) * Math.PI * 2;
    let y = mid;
    for (const [k, amp, phase] of harmonics) y += Math.sin(t * k + phase) * amp;
    points.push(`${((i / STEPS) * TILE).toFixed(1)} ${y.toFixed(1)}`);
  }
  return 'M' + points.join('L');
}

// Perspective: the far swell sits higher in the frame, runs shallower and
// travels slower. Kept angular rather than smooth, the way a sounder draws it.
const far = train(56, [
  [1, 8, 2.4],
  [2, 4, 0.3],
  [5, 1.8, 1.7],
]);

const near = train(92, [
  [1, 14, 0],
  [2, 7, 1.1],
  [3, 4, 2.3],
  [7, 2.5, 0.6],
]);

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const soundings = [
  [70, 118],
  [196, 130],
  [330, 122],
  [468, 134],
  [604, 120],
  [742, 132],
  [878, 124],
  [1016, 136],
  [1148, 122],
];
---

<div
  class:list={['waterline', compact && 'waterline--compact']}
  data-waterline
  aria-hidden="true"
>
  <svg
    class="waterline__train waterline__train--far"
    viewBox={`0 0 ${TILE * 2} 160`}
    preserveAspectRatio="none"
    fill="none"
  >
    <path
      d={far}
      stroke="var(--color-buoy)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <svg
    class="waterline__train waterline__train--near"
    viewBox={`0 0 ${TILE * 2} 160`}
    preserveAspectRatio="none"
    fill="none"
  >
    <path
      d={near}
      stroke="var(--color-buoy)"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  <svg
    class="waterline__marks"
    viewBox={`0 0 ${TILE} 160`}
    preserveAspectRatio="none"
    fill="none"
  >
    {
      soundings.map(([x, y]) => (
        <circle cx={x} cy={y} r="1.6" fill="var(--color-buoy)" opacity="0.55" />
      ))
    }
  </svg>
</div>
