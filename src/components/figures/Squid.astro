---
import { spine, shell } from '@/lib/curves';

// --- Squid ----------------------------------------------------------------
// Jets apex first, arms streaming behind, which is the shape it makes when it
// is going somewhere rather than hunting.
const squid = spine({
  from: 70,
  to: 180,
  y: () => 48,
  up: [
    [0, 11],
    [0.18, 13.5],
    [0.5, 11.5],
    [0.8, 6],
    [1, 0.8],
  ],
});

// Eight arms held in a bundle, which is the shape they make when the animal is
// travelling rather than hunting. Spread them out and it turns into a mop.
const ARMS = [
  'M52 45C42 42 30 41 18 40',
  'M52 47C40 45 26 44 12 44',
  'M52 49C38 48 22 48 8 49',
  'M52 51C40 51 26 53 14 55',
  'M52 53C42 55 32 58 22 62',
];

// The two long tentacles do the catching, and the paddle on the end of each is
// the only part with suckers on it.
const TENTACLES = ['M54 43C34 34 14 28-6 26', 'M54 51C32 54 12 62-4 72'];
const CLUBS =
  'M-6 26c-6-1-11 0-13 3 5 2 10 1 13-3ZM-4 72c-6 1-10 4-11 8 5-1 9-4 11-8Z';
---

<svg viewBox="-22 14 216 76" fill="none" stroke="currentColor" stroke-width="1">
  {/* Ink first in the paint order, so it puffs behind everything else. */}
  <circle cx="58" cy="52" r="13" class="drift__ink" />
  <path d={shell(squid)} />
  {/* One pair of fins at the apex, flaring off the mantle. The outer corner
      is rounded and the trailing edge runs into the tip: drawn as two
      pointed triangles they read as fletching on a paper dart. */}
  <path d="M122 39C140 30 156 24 166 24c6 0 10 6 11 13l3 11Z" stroke-width="0.8" />
  <path d="M122 57C140 66 156 72 166 72c6 0 10-6 11-13l3-11Z" stroke-width="0.8" />
  {/* Head at the mantle opening, and an eye out of all proportion to it. */}
  <path d="M70 37C60 38 52 42 52 48s8 10 18 11" stroke-width="0.9" />
  <path d="M70 37c-6 3-9 7-9 11s3 8 9 11" stroke-width="0.5" opacity="0.6" />
  <circle cx="62" cy="46" r="4.2" stroke-width="0.8" />
  <circle cx="62" cy="46" r="1.5" fill="currentColor" stroke="none" />
  {/* Funnel. Everything the animal does for speed comes out of this. */}
  <path d="M66 56c-5 2-9 5-11 9 4-1 8-3 11-6Z" stroke-width="0.7" />
  <path d={ARMS.join('')} stroke-width="0.7" opacity="0.85" />
  <path d={TENTACLES.join('')} stroke-width="0.6" opacity="0.7" />
  <path d={CLUBS} stroke-width="0.6" opacity="0.7" />
  <path d="M104 40h30M100 56h34" stroke-width="0.5" opacity="0.4" />
</svg>
