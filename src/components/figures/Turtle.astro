---
import { spine } from '@/lib/curves';

// --- Turtle ---------------------------------------------------------------
// A carapace in profile runs about two and a half times as long as it is deep,
// comes to a point over the tail and stops in a blunt wall at the front where
// the neck comes out. Taper it at both ends and it reads as a surfboard.
const shellNodes = spine({
  from: 34,
  to: 112,
  y: () => 50,
  up: [
    [0, 1],
    [0.14, 12],
    [0.36, 20],
    [0.56, 22],
    [0.76, 21],
    [0.92, 18],
    [1, 14],
  ],
  down: [
    [0, 1],
    [0.14, 6],
    [0.4, 10],
    [0.7, 10],
    [0.9, 9],
    [1, 7],
  ],
});

// Two open edges rather than a closed shell: a carapace has no wall across the
// front, it has an opening, and the neck comes out of it.
const carapace =
  'M' +
  shellNodes.map((p) => `${p.x.toFixed(1)} ${(p.y - p.u).toFixed(1)}`).join('L') +
  'M' +
  shellNodes.map((p) => `${p.x.toFixed(1)} ${(p.y + p.d).toFixed(1)}`).join('L');
---

<svg viewBox="26 26 114 68" fill="none" stroke="currentColor" stroke-width="1">
  {/* Far flipper first, so the near one paints over it. */}
  <path d="M96 58C91 66 82 74 70 80" stroke-width="0.6" opacity="0.4" />
  {/* Head. A fifth of the shell long, no more, and the hook on the beak is
      most of the recognition. Open at the back, so the neck runs into the
      shell opening instead of stopping against a wall. */}
  <path d="M108 38C116 33 127 32 133 35c3 2 4 5 2 7-3 3-10 4-16 4-6 0-10-1-13-4" />
  <path d="M135 42c-3 1-5 1-8 0" stroke-width="0.6" />
  <circle cx="124" cy="39" r="1.3" fill="currentColor" />
  <path d={carapace} />
  {/* Vertebral seams down the midline, and the line that separates them from
      the costal scutes on the flank. */}
  <path d="M52 36c1 7 1 13 0 20M68 30c1.5 10 1.5 19 0 29M84 29c-1 10-1 20 0 30M98 31c-1.5 9-1.5 19 0 28" stroke-width="0.5" opacity="0.55" />
  <path d="M36 46C56 34 92 34 110 42" stroke-width="0.5" opacity="0.55" />
  {/* Marginals, which is the row that gives the shell its sawn edge. */}
  <path d="M48 57l-1 3M64 60v3M80 60v3M96 60l1 3" stroke-width="0.5" opacity="0.5" />
  {/* The near front flipper on the downstroke: a long narrow blade, not a
      leaf. Its length is what makes this a sea turtle rather than a tortoise
      doing something unusual. */}
  <path d="M104 56C96 68 80 80 62 88c-4 2-7 0-5-3 6-10 22-24 38-32Z" stroke-width="0.9" />
  <path d="M99 58C92 68 78 78 62 85" stroke-width="0.4" opacity="0.5" />
  {/* Rear flipper, trailing as a rudder. */}
  <path d="M48 57c-2 8-7 14-14 17 0-7 4-13 9-16Z" stroke-width="0.8" />
</svg>
