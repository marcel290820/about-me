---
import { shell, torpedo } from '@/lib/curves';

const towHull = shell(torpedo(30, 132, 34, 11));
---

<svg viewBox="-6 0 160 108" fill="none" stroke="currentColor" stroke-width="1">
  {/* Towed on a warp that runs up and AHEAD to a ship you cannot see. A
      towed body goes where its cable goes, so the bail sits forward of
      centre and the warp leaves toward the nose. With the warp off the tail
      the fish swam backwards for every visitor. */}
  <path d="M100 23C114 14 130 4 154-6" stroke-width="0.6" opacity="0.5" />
  <path d="M100 23 96 27" stroke-width="0.7" />
  <path d={towHull} />
  <path d="M40 26v16M52 24v20" stroke-width="0.5" opacity="0.6" />
  <path d="M36 24 26 12h9l7 10M36 44 26 56h9l7-10" stroke-width="0.7" />
  <circle cx="118" cy="34" r="2.4" stroke-width="0.7" />
  {/* Two side-scan fans. The picture it is making is the point of it. */}
  <path d="M76 45 44 104M76 45 96 104" stroke-width="0.5" stroke-dasharray="2 4" opacity="0.55" />
  <path d="M50 96 92 96" stroke-width="0.5" stroke-dasharray="1 3" opacity="0.4" />
  <circle cx="76" cy="34" r="1.6" fill="currentColor" class="drift__telemetry" />
  <circle cx="76" cy="34" r="22" class="drift__ring" />
</svg>
<span class="drift__tag">SSS 400 kHz</span>
