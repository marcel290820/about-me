<svg viewBox="-2 -10 204 120" fill="none" stroke="currentColor" stroke-width="1">
  {/* Tether on to a lift bail. Everything useful at depth still needs its
      link home, and something has to take the weight of it. */}
  <path d="M86 4C80-3 76-6 70-9" stroke-width="0.6" opacity="0.5" />
  <path d="M74 12V4h24v8" stroke-width="0.7" />
  {/* Syntactic foam on top, in blocks. It is the buoyancy the rest hangs
      under, and it is the one solid thing on the whole vehicle. */}
  <path d="M32 12h108a9 9 0 0 1 0 18H32a9 9 0 0 1 0-18z" />
  <path d="M52 12v18M82 12v18M112 12v18" stroke-width="0.4" opacity="0.45" />
  {/* Posts and rails rather than a closed box: an ROV is a cage you can see
      straight through, and an outlined rectangle is a briefcase. */}
  <path d="M24 32h124M24 90h124" stroke-width="0.9" />
  <path d="M24 32v58M60 32v58M112 32v58M148 32v58" stroke-width="0.9" />
  {/* Braced at the ends, open through the middle where the kit rides. A rail
      all the way across turns the frame into a window with six panes. */}
  <path d="M24 62h36M112 62h36" stroke-width="0.7" />
  <path d="M24 62 60 32M148 62 112 32" stroke-width="0.5" opacity="0.45" />
  {/* Pressure housings. Round ends, because anything that holds one
      atmosphere against four hundred is a cylinder. */}
  <path d="M68 42h28a7 7 0 0 1 0 14H68a7 7 0 0 1 0-14z" stroke-width="0.6" opacity="0.7" />
  <path d="M68 66h18a6 6 0 0 1 0 12H68a6 6 0 0 1 0-12z" stroke-width="0.6" opacity="0.7" />
  {/* Two ducted thrusters aft. The duct is the part that says thruster; a
      bare circle says porthole. */}
  <g stroke-width="0.8">
    <path d="M2 38h22v20H2zM2 66h22v20H2z" />
    <circle cx="13" cy="48" r="7" />
    <circle cx="13" cy="48" r="2.4" />
    <circle cx="13" cy="76" r="7" />
    <circle cx="13" cy="76" r="2.4" />
  </g>
  {/* Camera on its pan and tilt, a lamp above and below on their own booms,
      and what the three of them together can actually see. */}
  <path d="M150 52h16v16h-16z" stroke-width="0.8" />
  <circle cx="171" cy="60" r="5.5" stroke-width="0.8" />
  <circle cx="172" cy="60" r="2" stroke-width="0.6" />
  <path d="M148 38h8M148 84h8" stroke-width="0.7" />
  <circle cx="160" cy="38" r="4" stroke-width="0.7" />
  <circle cx="160" cy="84" r="4" stroke-width="0.7" />
  <path d="M164 34 190 24M164 88 190 98M178 60h14" stroke-width="0.5" stroke-dasharray="3 4" opacity="0.5" />
  {/* Manipulator, out where it works rather than folded away. Three straight
      segments and a jaw; a curve here reads as a hose. */}
  <circle cx="148" cy="88" r="3" stroke-width="0.8" />
  <path d="M148 88 168 98 188 90" stroke-width="0.9" />
  <path d="m188 90 9-5M188 90l8 6" stroke-width="0.7" />
  {/* Two skids rather than one plinth: a runner the full width closes the
      frame off into a box again. */}
  <path d="M40 90v12M64 90v12M108 90v12M132 90v12" stroke-width="0.7" />
  <path d="M32 102h40M100 102h40" stroke-width="0.8" />
  <path d="m32 102-7-5M140 102l7-5" stroke-width="0.7" />
  <circle cx="86" cy="60" r="2.4" fill="currentColor" class="drift__telemetry" />
  <circle cx="86" cy="60" r="36" class="drift__ring" />
</svg>
<span class="drift__tag">ROV-01 &middot; Fl(2) 5s</span>
