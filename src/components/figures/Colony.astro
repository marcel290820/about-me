---
// --- Siphonophore ---------------------------------------------------------
// A colony, not an animal: a gas float at the top, a stack of swimming bells
// under it that beat together, then metres of feeding stem.
//
// Nectophores in two rows, each a rounded box with its opening turned down
// and out, packed so tightly that each overlaps the next. From a distance a
// nectosome is a cob, not a string of anything: trapezoids read as
// lampshades and circles read as grapes, both because they leave gaps.
const BELLS: [number, number, number, number][] = Array.from({ length: 11 }, (_, i) => [
  28 + (i % 2 ? 4.5 : -4.5),
  24 + i * 7.4,
  i % 2 ? 12 : -12,
  1 - i * 0.028,
]);
const BELL = 'M-6-7h12v9c0 3.5-2.5 6-6 6s-6-2.5-6-6z';
const VELUM = 'M-3 5q3 2 6 0';

// Cormidia down the stem at one interval, because the colony budded them at
// one interval. Each is a bract, a leaf-shaped scale that shields the stem,
// with one tentacle hanging off it, and the tentacles hang at their own
// lengths, which is the difference between a stem and a string of hooks.
const CORMIDIA = Array.from({ length: 9 }, (_, i) => {
  const y = 128 + i * 17;
  const s = i % 2 ? 1 : -1;
  // Shorter than the station interval: a tentacle that reaches the next
  // station's tentacle interleaves with it, and two interleaved curves are
  // a loop.
  const len = 9 + ((i * 5) % 6);
  const bract = `M28 ${y}c${s * 3} -2 ${s * 6} -1 ${s * 7} 2c${-s * 1} 2 ${-s * 4} 3 ${-s * 7} 1Z`;
  // Trails down and away, with one sway in it. Bent back toward the stem it
  // reads as a hook, and a stem of hooks is a vine.
  const tentacle =
    `M${28 + s * 4} ${y + 3}c${s * 3} 3 ${s * 5} 6 ${s * 4} ${len}` +
    `c${-s * 1} 2 ${-s * 1} 3 ${-s * 2} 4`;
  return bract + tentacle;
}).join('');
---

<svg viewBox="0 0 56 300" fill="none" stroke="currentColor" stroke-width="1">
  <path d="M28 20c3 22-4 44 0 66s-4 44 0 66 3 44 0 66 3 44 0 70" stroke-width="0.7" />
  {/* Gas float at the top. Everything under it hangs from this one bubble. */}
  <path d="M28 4c3 0 5 3 5 7s-2 8-5 8-5-4-5-8 2-7 5-7Z" stroke-width="0.9" />
  <path d="M26 8c1-1 3-1 4 0" stroke-width="0.5" opacity="0.7" />
  {BELLS.map(([x, y, tilt, s]) => (
    <g transform={`translate(${x} ${y}) rotate(${tilt}) scale(${s})`} stroke-width={(0.8 / s).toFixed(2)}>
      <path d={BELL} />
      <path d={VELUM} opacity="0.6" />
    </g>
  ))}
  <path d={CORMIDIA} stroke-width="0.5" opacity="0.8" />
</svg>
