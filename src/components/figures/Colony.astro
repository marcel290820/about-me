---
// --- Siphonophore ---------------------------------------------------------
// A colony, not an animal: a gas float at the top, a cluster of swimming
// bells under it that beat together, then metres of feeding stem. It climbs,
// so the float leads and everything else trails behind and below it.
import { spine, shell, type Node } from '@/lib/curves';

const NECK = 6;
const FOOT = 274;
const TOP_X = 34;

const clamp = (k: number) => (k < 0 ? 0 : k > 1 ? 1 : k);
const smooth = (k: number) => k * k * (3 - 2 * k);

// The stem, one function the whole way down, so every bell and every
// cormidium sits on a number the stem itself reads. One slow bow off to the
// left and no sway in it: the way a stem trails when the bells are pulling
// the colony up and to the right. A counter-sway was tried and read as a
// wave, which is a thing with stiffness; this has none.
function stemX(y: number): number {
  return TOP_X - 16 * smooth(clamp((y - NECK) / (FOOT - NECK)));
}
// Drawn in three lengths of falling weight so the far end thins away instead
// of stopping on a stub, and stopped short of the last tentacles so the
// fringe outlives it: run on past them, the tail was a bare ruled hairline
// down the last fifth of the figure. Drawn through the nectosome rather than
// under it, too -- the bells have to be seen hanging off a spine, or the
// cluster closes into one lump and the figure is a seed head.
const stemSeg = (y0: number, y1: number) =>
  'M' +
  Array.from({ length: Math.ceil((y1 - y0) / 3) + 1 }, (_, i) => Math.min(y0 + i * 3, y1))
    .map((y) => `${stemX(y).toFixed(1)} ${y.toFixed(1)}`)
    .join('L');

// Same numbers on every build. -0.5..0.5, scattered rather than ramped.
const scatter = (i: number) => ((i * 7 + 3) % 11) / 10 - 0.5;

// The pneumatophore: a gas bubble, and not an egg. Walled across the crown
// and widest above the middle, then drawn into a neck. The wall is the point
// -- tapered at the crown as well as the foot, the figure had two thin ends
// and no front, and the float read as the last bud on a stem rather than the
// head of the colony.
const FLOAT = shell(
  spine({
    from: 0,
    to: 12,
    steps: 30,
    up: [
      [0, 1.5],
      [0.16, 3.2],
      [0.42, 3.8],
      [0.78, 2.8],
      [1, 1.2],
    ],
    down: [
      [0, 1.7],
      [0.18, 3.5],
      [0.44, 4.1],
      [0.8, 3.0],
      [1, 1.3],
    ],
  }),
);

// A nectophore is a medusa bell pressed into service as an engine: a rounded
// outer dome, a flatter inner face where it presses against the stem, and a
// mouth narrower than the waist, because the thing is a nozzle.
//
// The profile is sampled off an analytic dome rather than hand-placed, AND at
// exactly the sample points spine() will ask for. That second half is the one
// that mattered: curves.ts eases between control points with a smoothstep
// whose slope is zero at both ends, so a profile given at any other spacing
// comes back as a staircase of flat spots, and that staircase is why three
// attempts at this bell rendered as folded paper.
const BELL_STEPS = 60;
const bellProf = (peak: number, knee: number, taper: number): [number, number][] =>
  Array.from({ length: BELL_STEPS + 1 }, (_, i) => {
    const t = i / BELL_STEPS;
    return [
      t,
      t <= knee
        ? peak * Math.sqrt(Math.max(0, 1 - Math.pow(1 - t / knee, 2)))
        : peak * (1 - taper * Math.pow((t - knee) / (1 - knee), 1.7)),
    ];
  });

// The mouth is closed on a shallow arc bowed OUTWARD, with a short crescent
// ruled inside its lower half for the ostium. Three other endings were tried
// and each failed its own way: shell()'s straight wall put two hard vertices
// on a flat bottom edge and the bells read as folded paper; an inward-bowed
// arc put a beak on each end; and leaving the mouth open lost the bell
// entirely once six of them overlap, because an open outline has no body to
// tell it apart from its neighbour's. A full velum arc across the mouth is
// the fourth failure -- it doubles the outline and only thickens the mass.
function chamber(n: Node[]) {
  const m = n[n.length - 1];
  const top = n.map((p) => `${p.x.toFixed(2)} ${(-p.u).toFixed(2)}`).join('L');
  const bot = n
    .slice(0, -1)
    .map((p) => `${p.x.toFixed(2)} ${p.d.toFixed(2)}`)
    .reverse()
    .join('L');
  return {
    body:
      `M${top}C${(m.x + 1).toFixed(2)} ${(-m.u * 0.45).toFixed(2)} ${(m.x + 1).toFixed(2)} ${(m.d * 0.45).toFixed(2)} ${m.x.toFixed(2)} ${m.d.toFixed(2)}L${bot}Z`,
    ostium:
      `M${(m.x - 0.3).toFixed(2)} ${(-m.u * 0.1).toFixed(2)}` +
      `C${(m.x - 2.5).toFixed(2)} ${(m.d * 0.3).toFixed(2)} ${(m.x - 1.7).toFixed(2)} ${(m.d * 0.8).toFixed(2)} ${(m.x - 0.15).toFixed(2)} ${(m.d * 0.95).toFixed(2)}`,
  };
}

// Local units: apex on the stem at the origin, mouth at +x. The inner face is
// the `down` edge, which is the one turned back toward the stem once the bell
// is tilted.
const BELL_LEN = 15;
const BELL = chamber(
  spine({
    from: 0,
    to: BELL_LEN,
    steps: BELL_STEPS,
    up: bellProf(4.7, 0.4, 0.36),
    down: bellProf(4.0, 0.3, 0.26),
  }),
);

// Two rows, mouths turned down and out, overlapping by about a tenth: enough
// to read as packed and little enough that each bell still shows its own dome
// and the spine still shows between the rows. Packed harder, every bell hid
// under the next and showed only its mouth end, which is a wedge; ramped in
// size down the column, the outline came out a fir tree. So: one size with a
// wide scatter on it so the two rows cannot tile, different angles per row,
// and one late bud at half size.
const BELLS: { x: number; y: number; s: number; tilt: number; side: number }[] = [];
for (let i = 0, y = 17; i < 6; i++) {
  const side = i % 2 ? -1 : 1;
  const s = (0.92 + 0.18 * scatter(i + 2)) * (i === 4 ? 0.6 : 1);
  BELLS.push({ x: stemX(y), y, s, tilt: (side > 0 ? 48 : 57) + 11 * scatter(i), side });
  y += 0.7 + 4.3 * s;
}

// A thread with no stiffness in it: falls for its first stretch, only then
// drifts away. The exponent in x is what holds that back, and it varies per
// station -- a fern pinna leaves the stem straight and at one fixed angle,
// which is the read to avoid.
function thread(x0: number, y0: number, lx: number, ly: number, lag: number) {
  const n = Math.max(7, Math.round(ly / 2));
  const pts = Array.from({ length: n + 1 }, (_, k) => {
    const u = k / n;
    return [x0 - lx * Math.pow(u, lag), y0 + ly * (1 - Math.pow(1 - u, 1.45))];
  });
  return { n, pts, d: 'M' + pts.map(([px, py]) => `${px.toFixed(1)} ${py.toFixed(1)}`).join('L') };
}

// Tentilla: a short stalk off the tentacle ending in a coil. Sampled off the
// same points the thread is drawn through so they cannot come off it. The
// coil is the point -- a straight side branch on a straight run is a
// fishbone, and a coiled tentillum is the one thing in this drawing that says
// siphonophore and nothing else. Only the longest tentacles carry them.
function tentilla(t: ReturnType<typeof thread>) {
  return [0.46, 0.72]
    .map((u) => {
      const k = Math.round(u * t.n);
      const [ax, ay] = t.pts[Math.max(0, k - 1)];
      const [bx, by] = t.pts[Math.min(t.n, k + 1)];
      const d = Math.hypot(bx - ax, by - ay) || 1;
      const tx = (bx - ax) / d;
      const ty = (by - ay) / d;
      const [px, py] = t.pts[k];
      // Off the run, then a loop back on itself.
      const sx = px + (tx * 0.6 - ty * 2.2);
      const sy = py + (ty * 0.6 + tx * 2.2);
      return (
        `M${px.toFixed(1)} ${py.toFixed(1)}L${sx.toFixed(1)} ${sy.toFixed(1)}` +
        `a0.85 0.85 0 1 1 ${(-tx * 0.5 - ty * 0.4).toFixed(1)} ${(-ty * 0.5 + tx * 0.4).toFixed(1)}`
      );
    })
    .join('');
}

// Cormidia are budded in pairs just below the nectosome and the stem
// elongates under them, so they sit in groups with the gaps between groups
// widening downward. Spaced at one interval the whole way they read as the
// teeth of a comb, which is what turned an earlier pass into a sprig.
const STATIONS: { y: number; lead: boolean }[] = [];
for (let g = 0, y = 58, gap = 20; g < 6; g++) {
  STATIONS.push({ y, lead: true });
  STATIONS.push({ y: y + 5.6 + 1.6 * scatter(g), lead: false });
  y += gap * (0.9 + 0.2 * (scatter(g) + 0.5));
  gap *= 1.18;
}

const CORMIDIA = STATIONS.map(({ y, lead }, i) => {
  const x = stemX(y);
  const s = i % 2 ? 1 : -1;

  // A folded plate, straight-sided and angular, lying against the stem: the
  // bract has to be told apart from the polyp at a glance, and drawn as
  // another soft ellipse the two collapsed into one bead on a string.
  const bract =
    `M${x.toFixed(1)} ${(y - 2.6).toFixed(1)}` +
    `L${(x - s * 3.1).toFixed(1)} ${(y + 1).toFixed(1)}` +
    `L${(stemX(y + 5.4) - s * 0.9).toFixed(1)} ${(y + 5.4).toFixed(1)}`;

  // A pear, and a sac rather than a bead: swings out from the stem and hangs,
  // widest and blunt at the bottom where the mouth is, left open at the top
  // because the join to the stem is the one line not drawn.
  const px = stemX(y + 3.4);
  const qx = stemX(y + 12.4);
  const polyp =
    `M${(px + s * 0.6).toFixed(1)} ${(y + 3.4).toFixed(1)}` +
    `C${(px + s * 3.2).toFixed(1)} ${(y + 6.2).toFixed(1)} ${(qx + s * 3.6).toFixed(1)} ${(y + 9.4).toFixed(1)} ${(qx + s * 1.4).toFixed(1)} ${(y + 12.4).toFixed(1)}` +
    `C${(qx - s * 1.4).toFixed(1)} ${(y + 9.8).toFixed(1)} ${(px - s * 1.9).toFixed(1)} ${(y + 6).toFixed(1)} ${(px - s * 0.5).toFixed(1)} ${(y + 3.6).toFixed(1)}`;

  // Only the leading cormidium of each pair streams a full tentacle, and the
  // second one trails a short one at every other group. Twelve threads at one
  // cadence read as blur; eight at four lengths read as structure.
  const jit = 0.6 + 0.8 * (scatter(i + 4) + 0.5);
  const grow = 0.45 + (0.55 * i) / 11;
  const y0 = y + 5.2;
  const has = lead || i % 4 === 1;
  const main = has
    ? thread(
        x + s * 0.4,
        y0,
        lead ? 4 + 13 * grow * jit : 2.6 + 3 * jit,
        lead ? Math.min(16 + 30 * grow * jit, 297 - y0) : Math.min(9 + 7 * jit, 297 - y0),
        1.9 + 1.4 * (scatter(i + 6) + 0.5),
      )
    : null;

  return {
    bract,
    polyp,
    tentacle: main ? main.d : '',
    tentilla: main && main.pts[main.n][1] - y0 > 30 ? tentilla(main) : '',
  };
});
---

<svg viewBox="0 0 52 300" fill="none" stroke="currentColor" stroke-width="1">
  {/* The siphosome carries real weight, not hairline: the figure ships at a
      fifth opacity, and drawn any lighter than this everything below the
      bells falls under the threshold and all that is left is a stalk. */}
  <path d={stemSeg(NECK, 196)} stroke-width="0.85" />
  <path d={stemSeg(196, 240)} stroke-width="0.6" opacity="0.85" />
  <path d={stemSeg(240, FOOT)} stroke-width="0.4" opacity="0.6" />
  <path d={CORMIDIA.map((c) => c.tentacle).join('')} stroke-width="0.5" opacity="0.85" />
  <path d={CORMIDIA.map((c) => c.tentilla).join('')} stroke-width="0.42" opacity="0.7" />
  <path d={CORMIDIA.map((c) => c.bract).join('')} stroke-width="0.6" opacity="0.9" />
  <path d={CORMIDIA.map((c) => c.polyp).join('')} stroke-width="0.7" />
  {/* The float and the bells carry about 1.6x the ink of the siphosome, so
      the top reads first and the trailing stem is the faint part. */}
  {BELLS.map(({ x, y, s, tilt, side }) => (
    <g
      transform={`translate(${x.toFixed(1)} ${y.toFixed(1)}) scale(${(side * s).toFixed(2)} ${s.toFixed(2)}) rotate(${tilt.toFixed(1)})`}
    >
      <path d={BELL.body} stroke-width={(0.95 / s).toFixed(2)} />
      <path d={BELL.ostium} stroke-width={(0.42 / s).toFixed(2)} opacity="0.55" />
    </g>
  ))}
  <g transform={`translate(${TOP_X} 2) rotate(90)`}>
    <path d={FLOAT} stroke-width="1.15" />
  </g>
  {/* The apical pore, on the crown wall. */}
  <circle cx={TOP_X} cy="3.4" r="0.8" fill="currentColor" stroke="none" />
</svg>
