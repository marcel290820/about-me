---
// --- School ---------------------------------------------------------------
// Nose at x=21, forked tail behind the origin. These render about 20px long,
// so the list of what still reads is short: a body that is deeper forward than
// aft, a fork, one dorsal, one eye. Everything past that turns to mud.
const FISH =
  // Body. Deepest a third back from the nose, which is what separates a fish
  // from the symmetrical lens shape that reads as clipart.
  'M0 5C3 1.3 7.6-0.8 12.6 0.2c4.4 0.9 7.2 2.5 8.4 4.8-1.2 2.3-4 3.9-8.4 4.8C7.6 10.8 3 8.7 0 5Z' +
  // Forked caudal.
  'M0 5-6.6 0.4-4.1 5-6.6 9.6Z' +
  // Dorsal, then a small anal fin under it.
  'M5 2C6.2-0.5 8.6-1.7 11.2-1.3L9.8 1.4' +
  'M6.4 8.4c0.7 2 1.8 3 3.4 3.2L9 9.2' +
  // Eye. A ring this small closes up into a dot at the size it is seen.
  'M16.2 4.2a0.85 0.85 0 1 0 0.01 0';

// Staggered so that no two bodies overlap: a fish drawn across another fish
// is a tangle of lines at this size, and one tangle spoils the whole school.
// The tagged one at (92, 2) is in this layout too, at 1.25.
const SCHOOL: [number, number, number][] = [
  [4, 0, 0.7],
  [2, 22, 0.9],
  [28, 6, 0.8],
  [38, 36, 0.86],
  [62, 20, 1],
  [98, 32, 0.74],
  [124, 18, 0.8],
];
---

<svg viewBox="-10 -12 156 58" fill="none" stroke="currentColor" stroke-width="1">
  {SCHOOL.map(([x, y, s]) => (
    <path d={FISH} transform={`translate(${x} ${y}) scale(${s})`} />
  ))}
  {/* The one that got caught, measured and let go again. An acoustic tag is
      real field kit, and it is the only thing down here still reporting. */}
  <g transform="translate(92 2) scale(1.25)">
    <path d={FISH} />
    {/* Clipped to the dorsal base, which is where one actually goes. */}
    <path d="M5.2-0.8h5.4v2.4H5.2z" stroke-width="0.7" />
    <path d="M10.6-0.8 14.8-5.2" stroke-width="0.7" />
    <path d="M15.2-7.4a4.6 4.6 0 0 1 2.8 3.6" class="drift__ping" />
    <path d="M17-10a7.8 7.8 0 0 1 4.7 6" class="drift__ping drift__ping--late" />
    <circle cx="7.9" cy="0.4" r="1" fill="currentColor" class="drift__telemetry" />
  </g>
</svg>
