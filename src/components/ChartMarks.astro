---
// Marginalia for the chart paper.
//
// Charts have always carried two registers at once. There is the notation --
// wreck symbols, tidal diamonds, light characteristics, a fix worked from three
// bearings -- and there is everything the cartographer drew in the empty water
// because empty water sells no charts: battles, monsters, the place somebody
// swore the money went down. Both are real chart vocabulary. Both are here.
//
// Nine marks, three printed per visit, in slots picked in the browser, so the
// margin is not the same margin twice.
//
// Paper does not move, so none of it animates.

import Rose from '@/components/marks/Rose.astro';
import Serpent from '@/components/marks/Serpent.astro';
import Engagement from '@/components/marks/Engagement.astro';
import Cache from '@/components/marks/Cache.astro';
import WreckSymbol from '@/components/marks/WreckSymbol.astro';
import Tidal from '@/components/marks/Tidal.astro';
import Gnss from '@/components/marks/Gnss.astro';
import TallShip from '@/components/marks/TallShip.astro';
import Fix from '@/components/marks/Fix.astro';
---

<div class="chart-marks" aria-hidden="true">
  {/* Variation rose. The dashed point is where a compass actually points, and
      the label is the angle between that and true. */}
  <div class="chart-mark" data-mark hidden><Rose /></div>

  {/* Sea serpent on the cable. */}
  <div class="chart-mark" data-mark hidden><Serpent /></div>

  {/* Two ships engaged, and the shot between them. Charts marked the water
      where a fleet action happened long after anyone cared who won. */}
  <div class="chart-mark" data-mark hidden><Engagement /></div>

  {/* Somebody's cache, still marked. The chart is not saying it is there, only
      that the story is old enough to print. */}
  <div class="chart-mark" data-mark hidden><Cache /></div>

  {/* The chart symbol for a wreck whose masts still break the surface, which
      is the only kind a chart has to warn you about. */}
  <div class="chart-mark" data-mark hidden><WreckSymbol /></div>

  {/* A tidal diamond: the letter refers you to a table of what the stream is
      doing at that spot at every hour of the tide. */}
  <div class="chart-mark" data-mark hidden><Tidal /></div>

  {/* The modern way to know the same thing the rose was for. */}
  <div class="chart-mark" data-mark hidden><Gnss /></div>

  {/* The one mark on this chart that is about its owner. Six months under
      sail, Oct 2018 to Apr 2019, Ireland to France round the Atlantic: the
      passage the rest of this page is drawn from. Pinned, so it prints on every visit; the other
      two marks are drawn from the bag around it. */}
  <div class="chart-mark" data-mark data-mark-pinned hidden><TallShip /></div>

  {/* Three bearings never quite cross at a point. The little triangle they
      leave instead has a name, and you are somewhere inside it. */}
  <div class="chart-mark" data-mark hidden><Fix /></div>
</div>

<script>
  // Three of the nine, in three of the six margin slots, drawn fresh each
  // load. Marginalia is what a cartographer put in the empty water, not what
  // they filled it with: printing five left no empty water.
  // [top%, side, offset%]
  const SLOTS: [number, 'left' | 'right', number][] = [
    [7, 'left', 2.5],
    [19, 'right', 3],
    [35, 'left', 3.5],
    [51, 'right', 2.5],
    [66, 'left', 2.5],
    [79, 'right', 4],
  ];

  const shuffle = <T,>(a: T[]) => {
    const out = a.slice();
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out;
  };

  // The owner's own passage prints every time; the rest of the margin is
  // drawn from the bag around it.
  const all = Array.from(document.querySelectorAll<HTMLElement>('[data-mark]'));
  const marks = [
    ...all.filter((m) => m.hasAttribute('data-mark-pinned')),
    ...shuffle(all.filter((m) => !m.hasAttribute('data-mark-pinned'))),
  ];

  shuffle(SLOTS)
    .slice(0, 3)
    .forEach(([top, side, offset], i) => {
      const mark = marks[i];
      if (!mark) return;
      mark.style.top = `${top}%`;
      mark.style[side] = `${offset}%`;
      mark.classList.toggle('chart-mark--right', side === 'right');
      mark.hidden = false;
    });
</script>
