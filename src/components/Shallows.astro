---
// The first few metres, from just under them.
//
// Two registers, and the split is the point. Down in the column every contact
// travels on its own and none of it is attached to anything. Up here nothing
// travels: the water does. The swell moves across the whole frame and the one
// thing in it is moored, riding what passes under it.
//
// That is also why there are no animals at the surface. The gradient down the
// page is notation first and life later: the top of the water is where the
// instruments and the chart grammar are, and it gets more alive the further
// down you go. Two elements is the whole register, and it should stay that
// way -- a screen of flat water is meant to read as flat water.

// --- The ceiling ----------------------------------------------------------
// The underside of the swell, and it is the largest moving thing on the page.
//
// Same construction as the waterline above, for the same reason: each profile
// is a sum of sines with INTEGER wave numbers over the tile, so y(0) === y(TILE)
// by definition. Two tiles are drawn side by side and the layer travels exactly
// one tile per cycle, which is what makes the loop seamless at any width.
const TILE = 1200;
const STEPS = 60;

type Harmonic = [waveNumber: number, amplitude: number, phase: number];

function train(mid: number, harmonics: Harmonic[]) {
  const pts: string[] = [];
  for (let i = 0; i <= STEPS * 2; i++) {
    const t = (i / STEPS) * Math.PI * 2;
    let y = mid;
    for (const [k, amp, phase] of harmonics) y += Math.sin(t * k + phase) * amp;
    pts.push(`${((i / STEPS) * TILE).toFixed(1)} ${y.toFixed(1)}`);
  }
  return 'M' + pts.join('L');
}

// Two trains rather than one line offset from itself. A surface seen from
// below has thickness, and two that travel at different speeds part and meet
// instead of holding a fixed gap the way a printed rule would.
const CEILING_FAR = train(35, [
  [1, 5.5, 1.2],
  [2, 2.8, 0.4],
  [5, 1.2, 2.1],
]);

const CEILING_NEAR = train(46, [
  [1, 7.5, 0],
  [2, 3.4, 1.9],
  [3, 1.8, 0.7],
  [7, 1.1, 2.6],
]);

// --- The buoy -------------------------------------------------------------
// The station this page reads from. Open-Meteo is asked for 54.25N 12.10E,
// and the depth rail prints that coordinate, so the thing actually reporting
// the wave height everything here is animating from is drawn floating in it.
//
// A yellow special mark with a St Andrew's cross topmark: that is the chart
// grammar for a data buoy specifically, and the X is the one part of it still
// legible at thirty pixels.
//
// One current runs through the whole drawing. It sets the buoy down-tide of
// its anchor, so the mooring leaves to the left and leans further the deeper
// it goes; the weed on the hull streams the other way. Symmetric machine,
// lopsided sea.

// Real chain, not a line. Links alternate face-on (an oval) and edge-on (a
// bar), which is how chain looks and how a chart draws it; at a hundred
// pixels that collapses to a dashed line, which is what chain is from a
// distance. Drawn as ovals both ways it was a string of pearls. The run
// leaves with a lead to the left, because a mooring under load hangs off the
// buoy, not straight under it.
function chain(
  top: number,
  links: number,
  pitch: number,
  rx: number,
  ry: number,
  xFrom: number,
  xTo: number,
) {
  return Array.from({ length: links }, (_, i) => {
    const y = top + i * pitch;
    const x = xFrom + ((xTo - xFrom) * i) / Math.max(1, links - 1);
    if (i % 2) return `M${x.toFixed(1)} ${(y - ry * 0.8).toFixed(1)}V${(y + ry * 0.8).toFixed(1)}`;
    return (
      `M${(x - rx).toFixed(1)} ${y}` +
      `a${rx} ${ry} 0 0 1 ${rx * 2} 0` +
      `a${rx} ${ry} 0 0 1 ${-rx * 2} 0`
    );
  }).join('');
}

// One link size the whole way down. A heavier clump under the swivel was
// tried as ballast and read as beads shrinking along a string.
const CHAIN = chain(123, 9, 8, 3.2, 4.4, 54, 50.5);

// The stretch section below the chain: a rubber cord, one stroke heavier
// than the rope under it, with an eye at each end. A zigzag was tried and
// read as a spring out of a physics diagram; two parallel lines with end
// bars read as a pipe. A mooring that could not give would snatch itself
// apart in the first gale, and this is the part that gives. It leans a
// little more than the chain: scope grows with depth.
const CORD_FROM: [number, number] = [50.5, 198];
const CORD_TO: [number, number] = [44, 267];
const CORD = (() => {
  const [ax, ay] = CORD_FROM;
  const [bx, by] = CORD_TO;
  return `M${ax} ${ay + 1.8}L${bx} ${by - 1.8}`;
})();

// Weed, which is what a season on station leaves on everything below the
// waterline. Downstream side only, and it all trails the same way, because
// the current does. One streamer off the underside twice the length of the
// rest and nearly flat in the current, one hooked off the rim, one short off
// the bridle chain: three matching hooks from one point read as a claw.
const GROWTH =
  'M80 65c3 7 10 11 20 10s10 -1 14 -2' +
  'M95 57c6 3 10 8 9 15' +
  'M71 78c5 1 8 4 10 9';
---

<div class="shallows" data-shallows aria-hidden="true">
  <div class="shallows__ceiling">
    <svg viewBox={`0 0 ${TILE * 2} 80`} preserveAspectRatio="none" fill="none">
      <path
        d={CEILING_FAR}
        stroke="currentColor"
        stroke-width="0.9"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    <svg viewBox={`0 0 ${TILE * 2} 80`} preserveAspectRatio="none" fill="none">
      <path
        d={CEILING_NEAR}
        stroke="currentColor"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>

  <div
    class="drift__figure shallows__buoy"
    style="opacity:.34"
    data-jitter="74 86"
    data-poke="ping"
  >
    <div class="drift__body">
      <svg viewBox="0 0 120 500" fill="none" stroke="currentColor" stroke-width="1">
        {/* The line has to go out rather than stop, and the fade belongs on
            the line itself. Masking the figure would have been shorter, but
            mask-clip is border-box by default and it took the label with it. */}
        <defs>
          <linearGradient id="moor-fade" gradientUnits="userSpaceOnUse" x1="60" y1="290" x2="60" y2="490">
            <stop offset="0" stop-color="currentColor" stop-opacity="0.7" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
        </defs>
        {/* Above the surface, and dimmed for it: you are underneath, looking
            up through moving water at the part that is not. The cross is the
            heaviest stroke in the figure so it survives the dimming; it is
            the mark, and it sits on a post like the real one, with the light
            on the post under it. */}
        <g opacity="0.7">
          <path d="M60 12V31" stroke-width="0.7" />
          <path d="M51 3 69 21M69 3 51 21" stroke-width="1.3" />
          <circle cx="60" cy="26" r="2.6" fill="currentColor" class="shallows__light" />
          {/* Tripod tower: two legs, a top and one rail. Bracing was tried
              and turned to a grey smudge at the size it is seen. The cup
              anemometer off one side is what says station rather than mark,
              and it is what makes the top lopsided. */}
          <path d="M52 31H68M52 31L38 47M68 31L82 47" stroke-width="0.7" />
          <path d="M45 39.5H75" stroke-width="0.5" />
          <path d="M52 31H42V27M37.5 27H46.5" stroke-width="0.6" />
          <circle cx="37.5" cy="27" r="1.2" stroke-width="0.6" />
          <circle cx="46.5" cy="27" r="1.2" stroke-width="0.6" />
        </g>
        {/* Discus hull, side on: a lens. Flat deck, then one shallow dish
            under it, deepest under the centre, meeting the deck at rounded
            shoulders and with no vertical side anywhere. Low freeboard and
            most of it under, which is why one of these rides a gale out
            instead of over. A half circle here was a bowl; a rounded box
            was a bathtub, and with the bridle under it a spinning top. The
            two dashes are the surface meeting the hull, so the freeboard
            reads before the ceiling supplies the water. */}
        <path d="M20 47H100C99 58 82 68 60 68C38 68 21 58 20 47Z" stroke-width="1.1" />
        <path d="M9 52H17M103 52H111" stroke-width="0.5" opacity="0.45" />
        <path d={GROWTH} stroke-width="0.6" opacity="0.7" />
        {/* One sensor hung off the underside, off centre and clear of the
            bridle. The hull only floats it. */}
        <path d="M48 67V71" stroke-width="0.6" />
        <circle cx="48" cy="73.5" r="2.2" fill="currentColor" class="drift__telemetry" />
        {/* Bridle from under the rim to one ring, then a swivel. Three legs
            on the real thing; two show from the side, and they are not the
            same length: the ring hangs off centre toward the anchor, which
            is what the load does to it. Hairline, so the hull and bridle
            together do not close into a glass. */}
        <path d="M32 62L54 95M88 62L54 95" stroke-width="0.55" />
        <circle cx="54" cy="98.5" r="3.5" stroke-width="0.8" />
        <circle cx="54" cy="105" r="2.2" stroke-width="0.6" />
        <path d="M52 107.5h4v7h-4z" stroke-width="0.6" />
        <circle cx="54" cy="117" r="2.2" stroke-width="0.6" />
        <path d={CHAIN} stroke-width="0.6" />
        <circle cx="50.5" cy="193" r="2.4" stroke-width="0.6" />
        <circle cx="50.5" cy="198" r="1.8" stroke-width="0.6" />
        <path d={CORD} stroke-width="0.9" />
        <circle cx="44" cy="267" r="1.8" stroke-width="0.6" />
        {/* A float partway down holds the scope clear of the ground. In line,
            so the rope runs into it and out again. */}
        <path d="M44 268.8L43.5 272" stroke-width="0.6" />
        <circle cx="43" cy="281" r="9" stroke-width="0.9" />
        <path d="M34.6 281.5a8.4 3 0 0 0 16.8 0" stroke-width="0.4" opacity="0.6" />
        {/* And it keeps going, and keeps leaning: steep under the buoy,
            flattening toward an anchor further down than this page. */}
        <path d="M43 290C41 355 28 430 12 500" stroke="url(#moor-fade)" stroke-width="0.6" />
        <circle cx="60" cy="56" r="44" class="drift__ring" />
      </svg>
    </div>
  </div>
</div>

<script>
  // Where it sits is decided in the browser, the same as the water column, so
  // two visits do not open on the same picture. Only position: what is here
  // does not vary, because it is moored and there is one of it.
  const layer = document.querySelector('[data-shallows]');

  if (layer) {
    const room = layer.getBoundingClientRect().width;

    for (const el of layer.querySelectorAll<HTMLElement>('[data-jitter]')) {
      const [lo, hi] = el.dataset.jitter!.split(' ').map(Number);
      // Held back off the right edge by its own width. The layer clips, and a
      // buoy with half its hull cut off reads as a rendering fault.
      const fits = Math.max(0, 100 - (el.offsetWidth / room) * 100 - 1);
      el.style.left = `${Math.min(lo + Math.random() * (hi - lo), fits).toFixed(1)}%`;
    }
  }
</script>
