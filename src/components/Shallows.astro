---
// The first few metres, from just under them.
//
// Two registers, and the split is the point. Down in the column every contact
// travels on its own and none of it is attached to anything. Up here nothing
// travels: the water does. The swell moves across the whole frame and the one
// thing in it is moored, riding what passes under it.
//
// That is also why there are no animals at the surface. The gradient down the
// page is notation first and life later: the top of the water is where the
// instruments and the chart grammar are, and it gets more alive the further
// down you go. Two elements is the whole register, and it should stay that
// way -- a screen of flat water is meant to read as flat water.

// --- The ceiling ----------------------------------------------------------
// The underside of the swell, and it is the largest moving thing on the page.
//
// Same construction as the waterline above, for the same reason: each profile
// is a sum of sines with INTEGER wave numbers over the tile, so y(0) === y(TILE)
// by definition. Two tiles are drawn side by side and the layer travels exactly
// one tile per cycle, which is what makes the loop seamless at any width.
const TILE = 1200;
const STEPS = 60;

type Harmonic = [waveNumber: number, amplitude: number, phase: number];

function train(mid: number, harmonics: Harmonic[]) {
  const pts: string[] = [];
  for (let i = 0; i <= STEPS * 2; i++) {
    const t = (i / STEPS) * Math.PI * 2;
    let y = mid;
    for (const [k, amp, phase] of harmonics) y += Math.sin(t * k + phase) * amp;
    pts.push(`${((i / STEPS) * TILE).toFixed(1)} ${y.toFixed(1)}`);
  }
  return 'M' + pts.join('L');
}

// Two trains rather than one line offset from itself. A surface seen from
// below has thickness, and two that travel at different speeds part and meet
// instead of holding a fixed gap the way a printed rule would.
const CEILING_FAR = train(35, [
  [1, 5.5, 1.2],
  [2, 2.8, 0.4],
  [5, 1.2, 2.1],
]);

const CEILING_NEAR = train(46, [
  [1, 7.5, 0],
  [2, 3.4, 1.9],
  [3, 1.8, 0.7],
  [7, 1.1, 2.6],
]);

// --- The buoy -------------------------------------------------------------
// The station this page reads from. Open-Meteo is asked for 54.25N 12.10E,
// and the depth rail prints that coordinate, so the thing actually reporting
// the wave height everything here is animating from is drawn floating in it.
//
// A yellow special mark with a St Andrew's cross topmark: that is the chart
// grammar for a data buoy specifically, and the X is the one part of it still
// legible at thirty pixels.

// Real chain, not a line. Links alternate face-on and edge-on, which is how
// chain looks and how a chart draws it.
const CHAIN = Array.from({ length: 13 }, (_, i) => {
  const y = 120 + i * 8;
  const rx = i % 2 ? 3.6 : 1.2;
  return (
    `M${(60 - rx).toFixed(1)} ${y}` +
    `a${rx} 5 0 0 1 ${rx * 2} 0` +
    `a${rx} 5 0 0 1 ${-rx * 2} 0`
  );
}).join('');

// The stretch section below the chain. A mooring that could not give would
// snatch itself apart in the first gale.
const CORD = Array.from({ length: 6 }, (_, i) => {
  const y = 240 + i * 14;
  const a = i % 2 ? 52 : 68;
  const b = i % 2 ? 74 : 46;
  return `M${a} ${y}C${b} ${y + 4} ${b} ${y + 10} ${a} ${y + 14}`;
}).join('');

// Weed and mussels on everything below the waterline, which is what a season
// on station leaves on a hull.
const GROWTH =
  'M36 78c-3 6-2 11 1 15M44 82c-2 7 0 12 3 15M52 84c-3 6-3 12 0 16' +
  'M60 84c-1 7 1 12 4 15M68 83c-3 6-3 11 0 15M76 79c-2 6-1 11 2 14';
---

<div class="shallows" data-shallows aria-hidden="true">
  <div class="shallows__ceiling">
    <svg viewBox={`0 0 ${TILE * 2} 80`} preserveAspectRatio="none" fill="none">
      <path
        d={CEILING_FAR}
        stroke="currentColor"
        stroke-width="0.9"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    <svg viewBox={`0 0 ${TILE * 2} 80`} preserveAspectRatio="none" fill="none">
      <path
        d={CEILING_NEAR}
        stroke="currentColor"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>

  <div
    class="drift__figure shallows__buoy"
    style="opacity:.34"
    data-jitter="74 86"
    data-poke="ping"
  >
    <div class="drift__body">
      <svg viewBox="0 0 120 560" fill="none" stroke="currentColor" stroke-width="1">
        {/* The line has to go out rather than stop, and the fade belongs on
            the line itself. Masking the figure would have been shorter, but
            mask-clip is border-box by default and it took the label with it. */}
        <defs>
          <linearGradient id="moor-fade" gradientUnits="userSpaceOnUse" x1="60" y1="352" x2="60" y2="548">
            <stop offset="0" stop-color="currentColor" stop-opacity="0.7" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0" />
          </linearGradient>
        </defs>
        {/* Above the surface, and dimmed for it: you are underneath, looking
            up through moving water at the part that is not. */}
        <g opacity="0.5">
          <path d="M50 4 70 20M70 4 50 20" stroke-width="0.9" />
          <path d="M52 52V28M68 52V28" stroke-width="0.7" />
          <path d="M52 48 68 42 52 36 68 30" stroke-width="0.45" opacity="0.7" />
          <circle cx="60" cy="25" r="2.4" fill="currentColor" class="shallows__light" />
        </g>
        {/* Discus hull. Low freeboard and most of it under, which is why one
            of these rides a gale out instead of over. */}
        <path d="M26 46C26 70 41 84 60 84C79 84 94 70 94 46Z" />
        <path d="M27 58h66" stroke-width="0.5" opacity="0.5" />
        <path d={GROWTH} stroke-width="0.5" opacity="0.6" />
        <path d="M34 70l3 2M42 76l3 2M70 76l3 2M80 68l3 2" stroke-width="0.6" opacity="0.5" />
        {/* The instrument well slung under the hull. The hull only floats it. */}
        <path d="M52 84h16v16h-16z" stroke-width="0.8" />
        <path d="M52 100C52 106 56 110 60 110C64 110 68 106 68 100" stroke-width="0.8" />
        <circle cx="60" cy="92" r="2.2" fill="currentColor" class="drift__telemetry" />
        {/* Mooring eye, then chain, a swivel, and the stretch section. */}
        <path d="M60 110v4" stroke-width="0.6" />
        <circle cx="60" cy="117" r="4" stroke-width="0.8" />
        <path d={CHAIN} stroke-width="0.6" />
        <circle cx="60" cy="224" r="2.4" stroke-width="0.6" />
        <path d="M57 228h6v10h-6z" stroke-width="0.6" />
        <path d={CORD} stroke-width="0.55" opacity="0.85" />
        {/* A float partway down holds the scope clear of the ground. */}
        <path d="M60 324v6" stroke-width="0.6" />
        <circle cx="60" cy="341" r="11" stroke-width="0.8" />
        <path d="M53 336a10 10 0 0 1 9-4" stroke-width="0.4" opacity="0.6" />
        {/* And it keeps going. The anchor is further down than this page. */}
        <path d="M60 352V560" stroke="url(#moor-fade)" stroke-width="0.6" />
        <path d="M55 396h10M55 448h10M55 500h10" stroke="url(#moor-fade)" stroke-width="0.5" opacity="0.6" />
        <circle cx="60" cy="66" r="62" class="drift__ring" />
      </svg>
    </div>
  </div>
</div>

<script>
  // Where it sits is decided in the browser, the same as the water column, so
  // two visits do not open on the same picture. Only position: what is here
  // does not vary, because it is moored and there is one of it.
  const layer = document.querySelector('[data-shallows]');

  if (layer) {
    const room = layer.getBoundingClientRect().width;

    for (const el of layer.querySelectorAll<HTMLElement>('[data-jitter]')) {
      const [lo, hi] = el.dataset.jitter!.split(' ').map(Number);
      // Held back off the right edge by its own width. The layer clips, and a
      // buoy with half its hull cut off reads as a rendering fault.
      const fits = Math.max(0, 100 - (el.offsetWidth / room) * 100 - 1);
      el.style.left = `${Math.min(lo + Math.random() * (hi - lo), fits).toFixed(1)}%`;
    }
  }
</script>
