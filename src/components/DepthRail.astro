---
// Sticky instrument column. Reads scroll position as depth (0-48m) and shows
// live sea state from the Baltic off Rostock. Both are wired up in Base.astro.
const ticks = [0, 12, 24, 36, 48];
---

<aside class="depth-rail" data-depth-rail>
  <div class="depth-rail__scale" aria-hidden="true">
    {
      ticks.map((depth, i) => (
        <span
          class="depth-rail__tick"
          data-tick-depth={depth}
          style={`top: ${(i / (ticks.length - 1)) * 100}%`}
        >
          <span>{depth}</span>
        </span>
      ))
    }
    <div class="depth-rail__marker">
      <span class="depth-rail__depth"
        ><em data-depth-value style="font-style: normal">0</em> <span>M</span></span
      >
    </div>
  </div>

  <dl class="depth-rail__live">
    <dt class="depth-rail__place">
      Rostock<br />54.25N 12.10E
    </dt>
    <div class="flex gap-2">
      <dt>Hs</dt>
      <dd data-sea-hs>&ndash;&ndash;</dd>
    </div>
    <div class="flex gap-2">
      <dt>SST</dt>
      <dd data-sea-sst>&ndash;&ndash;</dd>
    </div>
    <div class="flex gap-2">
      <dt>obs</dt>
      <dd data-sea-time>&ndash;&ndash;</dd>
    </div>
  </dl>
</aside>

<!-- Below 1024px the rail is hidden, so the instrument condenses to this. -->
<div class="depth-badge" aria-hidden="true">
  <span class="depth-badge__depth"><em data-depth-value style="font-style: normal">0</em> m</span>
  <span class="depth-badge__rule"></span>
  <span>Hs <b data-sea-hs>&ndash;&ndash;</b></span>
</div>

<script>
  // The badge is fixed chrome and a phone has no gutter to keep it in, so it
  // yields: while any inset (a plate, a survey, the index) is in the band
  // along the bottom of the frame where the badge sits, the badge goes off
  // the edge. The band is the bottom tenth of the viewport, a little more
  // than the badge itself.
  const badge = document.querySelector('.depth-badge');
  const insets = document.querySelectorAll('.portrait-inset__frame');
  if (badge && insets.length) {
    const over = new Set<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? over.add(e.target) : over.delete(e.target);
        badge.classList.toggle('is-clear', over.size > 0);
      },
      { rootMargin: '-90% 0px 0px 0px' },
    );
    insets.forEach((el) => io.observe(el));
  }
</script>
