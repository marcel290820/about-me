---
// One chart sheet per project. The stack is the set of marks: every name is
// a landmark on the frame, drawn as its logo with the name beside it, with a
// bearing run in to the fix and its degrees written along the line; and the
// fix is the project. Marks sit on all four frames so the bearings arrive
// from opposing quadrants, the way a fix is actually taken, and on the frame
// rather than at the ends of floating lines because edge slots cannot
// collide. The geometry is in src/lib/sheet.ts, where its check lives.
//
// Two plates print, one landscape for sm and up and one portrait for
// phones, and CSS shows one. At a third of its drawn size the landscape
// sheet is a strip and the marks are specks; the portrait one keeps the
// idea at that width and leaves the names to the line under the plate.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { ICON, TALL, TICK, WIDE, layout, type Layout, type Mark, type Plate } from '@/lib/sheet';
import { logo } from '@/lib/logos';
import { ORGS } from '@/lib/orgs';
import { TIERS, tierOf } from '@/lib/projects';

interface Props {
  /** The entry's id, which is the anchor the index of sheets links to. */
  id: string;
  project: CollectionEntry<'projects'>['data'];
  /** Where this sheet falls in the catalogue, one-based, and how many there are. */
  index: number;
  total: number;
}

const { id, project: p, index, total } = Astro.props;
const hasLogo = (name: string) => logo(name) !== undefined;
const plates: { plate: Plate; cls: string; L: Layout }[] = [
  { plate: WIDE, cls: 'sheet__plate--wide', L: layout(p.title, p.stack, hasLogo, WIDE) },
  { plate: TALL, cls: 'sheet__plate--tall', L: layout(p.title, p.stack, hasLogo, TALL) },
];

// A mark without a logo is a plain tick into the plate from the frame.
const tick = (m: Mark, { w, h }: Plate) =>
  ({
    top: `M${m.at.toFixed(1)} 0v${TICK}`,
    bottom: `M${m.at.toFixed(1)} ${h}v-${TICK}`,
    right: `M${w} ${m.at.toFixed(1)}h-${TICK}`,
    left: `M0 ${m.at.toFixed(1)}h${TICK}`,
  })[m.edge];
const bearing = (m: Mark, L: Layout) => `M${m.from.x.toFixed(1)} ${m.from.y.toFixed(1)}L${L.fix.x} ${L.fix.y}`;
const graticule = (L: Layout, { w, h }: Plate) =>
  L.grid.x.map((x) => `M${x} 0V${h}`).join('') + L.grid.y.map((y) => `M0 ${y}H${w}`).join('');

const pad = (n: number) => String(n).padStart(2, '0');
const deg = (n: number) => String(n).padStart(3, '0');
const years = p.to && p.to !== p.from ? `${p.from} to ${p.to}` : `${p.from}`;
// How much of the work ran through a mark, read off the commit history when
// the sheet was drawn. The bearing is drawn heavier the higher the tier, the
// way a chart draws the line to a conspicuous mark heavier than to one it
// can barely make out. The projects page prints the key once, at its head.
const tier = (name: string) => tierOf(p, name);
// The caption numbers the sheet within its series, the way charts are
// numbered within the folio that holds them.
const code = ORGS[p.org].code;
// The source stamp under the frame: the GitHub mark and the repository path
// when the source is public, a lock when it is not. Both print in the same
// place, so a private sheet says so rather than leaving a gap.
const repoPath = p.repo ? new URL(p.repo).pathname.replace(/^\//, '') : null;
const GITHUB =
  '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>';
const LOCK = '<rect x="5" y="10.5" width="14" height="10" rx="1"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>';
// The inset's caption names the site it surveyed and the day it was surveyed.
const host = p.url ? new URL(p.url).hostname.replace(/^www\./, '') : null;
const surveyed = p.preview?.surveyed.toISOString().slice(0, 10);
const link =
  'font-mono text-[0.625rem] uppercase tracking-[0.14em] text-text-muted hover:text-accent transition-colors';
---

<article class="sheet" id={id} data-sheet style={`--n:${p.stack.length - 1}`}>
  <figure class="portrait-inset w-full">
    <div class="portrait-inset__frame">
      {plates.map(({ plate, cls, L }) => (
        <svg viewBox={`0 0 ${plate.w} ${plate.h}`} class:list={['sheet__plate', cls]} aria-hidden="true" fill="none" stroke="currentColor">
          <path d={graticule(L, plate)} stroke-width="0.5" opacity="0.14" />
          {/* The fix: the passage plot's marker inside a dashed circle with
              four ticks, the way the cocked-hat mark in the margin draws one.
              The heaviest thing on the sheet, because it is the point. Drawn
              before the marks so a bearing lit on hover runs over the ring. */}
          <g class="sheet__fix">
            <circle cx={L.fix.x} cy={L.fix.y} r="10" stroke-width="0.6" stroke-dasharray="1 3" />
            <path d={`M${L.fix.x} ${L.fix.y - 14}v4M${L.fix.x} ${L.fix.y + 10}v4M${L.fix.x - 14} ${L.fix.y}h4M${L.fix.x + 10} ${L.fix.y}h4`} stroke-width="0.6" />
            <circle cx={L.fix.x} cy={L.fix.y} r="4" stroke-width="1.3" fill="var(--color-surface)" />
          </g>
          {/* One group per mark: its bearing, its logo (or tick), its name
              and its degrees, so hovering any part of it lights the whole.
              Each bearing carries its index so the draw-on can stagger
              them. */}
          {L.marks.map((m, i) => (
            <g class="sheet__mark" data-tier={tier(m.name)}>
              <path d={bearing(m, L)} class="sheet__bearing" pathLength="1" style={`--i:${i}`} />
              {m.icon ? (
                <svg
                  x={(m.icon.x - ICON / 2).toFixed(1)}
                  y={(m.icon.y - ICON / 2).toFixed(1)}
                  width={ICON}
                  height={ICON}
                  viewBox="0 0 24 24"
                  class="sheet__logo"
                  fill="currentColor"
                  stroke="none"
                  set:html={logo(m.name)}
                />
              ) : (
                <path d={tick(m, plate)} stroke-width="0.8" />
              )}
              {plate.names && (
                <text class="sheet__name" x={m.text.x.toFixed(1)} y={m.text.y.toFixed(1)} text-anchor={m.text.anchor}>{m.name}</text>
              )}
              {plate.names && (
                <text
                  class="sheet__deg"
                  x={m.degree.x.toFixed(1)}
                  y={m.degree.y.toFixed(1)}
                  dy="-2.5"
                  text-anchor="middle"
                  transform={`rotate(${m.degree.rotate.toFixed(1)} ${m.degree.x.toFixed(1)} ${m.degree.y.toFixed(1)})`}
                >{deg(m.bearing)}</text>
              )}
            </g>
          ))}
        </svg>
      ))}
      {/* The title block is HTML so it wraps instead of truncating and holds
          its size on a phone. It sits over the plate's bottom-left corner,
          which no bearing reaches: the geometry keeps every mark and every
          line clear of it. */}
      <div class="absolute left-[5px] bottom-[5px] max-w-[60%] flex flex-col gap-0.5 sm:gap-1 px-2 py-1.5 sm:px-3 sm:py-2 border border-border-bright bg-surface">
        <span class="label text-[0.6875rem] sm:text-[0.8125rem] leading-tight text-text">{p.title}</span>
        <span class="flex justify-between gap-6 font-mono text-[0.5625rem] sm:text-[0.6875rem] uppercase tracking-[0.14em] text-accent">
          <span>{p.domain}</span>
          <span>{years}</span>
        </span>
      </div>
    </div>
    <figcaption class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5">
      {p.repo && repoPath ? (
        <a class="sheet__source" href={p.repo} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={GITHUB} />
          <span>{repoPath}</span>
        </a>
      ) : (
        <span class="sheet__source sheet__source--private" title="The source is private">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true" set:html={LOCK} />
          <span>source private</span>
        </span>
      )}
      <span class="ml-auto">{code} series, sheet {pad(index)} of {pad(total)}</span>
    </figcaption>
  </figure>

  <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
    <div class="sm:flex-1">
      <p class="text-[0.9375rem] text-text-muted">{p.description}</p>
      {/* Under sm the plate carries logos only and this line carries the names,
          logos and all. Above sm it is for screen readers, since the plate is
          hidden from them. */}
      <dl class="mt-3 flex flex-col gap-1.5 font-mono text-xs text-text-dim sm:sr-only">
        {TIERS.map(([t, label]) => {
          const names = p.stack.filter((s) => tier(s) === t);
          return (
            names.length > 0 && (
              <div class="grid grid-cols-[5.25rem_1fr] gap-x-3">
                <dt class="text-[0.625rem] uppercase tracking-[0.14em] text-text-faint pt-px">{label}</dt>
                <dd class="flex flex-wrap gap-x-4 gap-y-1.5">
                  {names.map((s) => (
                    <span class="inline-flex items-center gap-1.5">
                      {logo(s) && (
                        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={logo(s)} />
                      )}
                      {s}
                    </span>
                  ))}
                </dd>
              </div>
            )
          );
        })}
      </dl>
      {/* The survey inset is itself the link out, so a sheet that carries
          one does not repeat it here; the source is the stamp under the
          frame. */}
      {p.url && !p.preview && (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class:list={['inline-block mt-3', link]}>live &rarr;</a>
      )}
    </div>
    {/* A sheet's inset: the harbour plan a chart prints in the margin of the
        approach. It is a survey, dated under the frame, not a window on the
        live site, so it is a picture and the caption says when it was taken. */}
    {p.preview && p.url && host && (
      <figure class="sheet__shot portrait-inset w-full max-w-[15rem] sm:max-w-none sm:w-56 sm:shrink-0" data-tone={p.preview.tone}>
        <a class="portrait-inset__frame block" href={p.url} target="_blank" rel="noopener noreferrer">
          <Image
            src={p.preview.src}
            alt={`The site at ${host} as it looked on ${surveyed}`}
            widths={[320, 640]}
            sizes="(min-width: 640px) 16rem, 90vw"
            format="webp"
            quality={70}
          />
        </a>
        {/* The host is what the reader acts on; the date is the small print
            that keeps the shot honest, so they do not carry the same weight. */}
        <figcaption class="self-start leading-snug">
          <span class="block text-text-muted">{host}</span>
          <span class="block">surveyed {surveyed}</span>
        </figcaption>
      </figure>
    )}
  </div>
</article>

<script>
  // Armed only when the page can animate: the arming is what hides the
  // bearings and the fix, so a visitor with no script or with reduced motion
  // gets the finished sheet. Copied from Passage.astro on purpose; two
  // copies of twenty lines cost less than an abstraction over two callers.
  const sheets = document.querySelectorAll<HTMLElement>('[data-sheet]');
  if (sheets.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-seen');
          seen.unobserve(e.target);
        }
      },
      // A quarter, not the passage's third: a sheet with its text is taller
      // than a plot, and a phone shows less of it at once.
      { threshold: 0.25 },
    );
    for (const el of sheets) {
      el.classList.add('is-armed');
      seen.observe(el);
      // Once the fix is up the drawn sheet is the resting state again, so a
      // cancelled animation later cannot run it again from nothing. The fix
      // is the last thing to land, so it is the one to wait for.
      const settle = (e: AnimationEvent) => {
        if (e.animationName !== 'sheet-fix') return;
        el.classList.remove('is-armed');
        el.removeEventListener('animationend', settle);
      };
      el.addEventListener('animationend', settle);
    }
  }
</script>
