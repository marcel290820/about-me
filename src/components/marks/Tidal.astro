---
// --- Tidal diamond ----------------------------------------------------------
// The diamond is a key, not a picture: the letter inside it sends you to a
// column of the tidal stream table, which gives the set and the spring and
// neap rates for every hour either side of high water at the standard port.
// The excerpt beside it is that column, and its high water row is the figure
// the label quotes.
//
// The figures are real and are set as the strokes they turn into at this size,
// one stroke per character, so the groups still read as three figures and two
// rates and the columns still line up. Drawn as one dash per cell they were a
// comb of rules; the gaps between the characters are what make them numbers.
// Five rows, not thirteen: the whole table printed here is a grey rectangle of
// noise, and an excerpt is allowed to be an excerpt.
//
// What makes a grid read as a table is not the grid. Ruling every row came out
// a window, and ruling every column came out a wireframe that outweighed the
// diamond the mark is named for. One rule under the head and one down the side
// of the hours is all the structure figures in columns need. The columns are
// also sized to what they hold, so a three-figure set is visibly wider than a
// two-figure rate rather than the same block twice.

const TABLE: string[][] = [
  ['-2', '041', '3.0', '1.6'],
  ['-1', '045', '3.4', '1.8'],
  ['HW', '048', '3.1', '1.7'],
  ['+1', '052', '2.6', '1.4'],
  ['+2', '061', '1.9', '1.0'],
];
const HEAD = ['Dir', 'Sp', 'Np'];
const COLS = [54.5, 65.5, 78.5, 91.5];
const HW = 2;

// What each character comes to at this size. A point is a tick, a sign is
// short, everything else is a body.
const CHAR: Record<string, number> = { '.': 0.6, '-': 1.6, '+': 2.2 };
const GAP = 1;

const setLine = (cx: number, y: number, text: string, scale = 1) => {
  const w = [...text].map((c) => (CHAR[c] ?? 2.7) * scale);
  const total = w.reduce((s, v) => s + v, 0) + GAP * (w.length - 1);
  let x = cx - total / 2;
  return w
    .map((v) => {
      const d = `M${x.toFixed(2)} ${y}h${v.toFixed(2)}`;
      x += v + GAP;
      return d;
    })
    .join('');
};

const ROWS = TABLE.map((row, i) =>
  row.map((text, c) => setLine(COLS[c], 21 + i * 7, text)).join(''),
);
const CAPTIONS = HEAD.map((text, c) => setLine(COLS[c + 1], 10.5, text, 0.8)).join('');

// The stream sets 048, so the arrow points 048 and leaves the diamond on that
// side. A horizontal arrow floating in the corner under a label that gives a
// bearing is the one thing here a navigator would catch from across the room.
const SET = 48;
const rad = (d: number) => (d * Math.PI) / 180;
const FROM = [31.89, 23.89];
const LEN = 15;
const TIP = [FROM[0] + Math.sin(rad(SET)) * LEN, FROM[1] - Math.cos(rad(SET)) * LEN];
const TIP_D = `${TIP[0].toFixed(2)} ${TIP[1].toFixed(2)}`;
const barb = (spread: number, len = 3.4) =>
  `${(TIP[0] + Math.sin(rad(SET + 180 + spread)) * len).toFixed(2)} ${(
    TIP[1] -
    Math.cos(rad(SET + 180 + spread)) * len
  ).toFixed(2)}`;
const ARROW = `M${FROM[0]} ${FROM[1]}L${TIP_D}M${barb(-20)}L${TIP_D}L${barb(20)}`;
---

<svg
  viewBox="0 0 104 58"
  fill="none"
  stroke="currentColor"
  stroke-width="0.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {/* A diamond is a square on its point, not a lozenge. */}
  <path d="M24 16 39 31 24 46 9 31Z" stroke-width="0.85" />
  <path d="M24 24 19 39.5M24 24 29 39.5M21.2 35.5h5.6" stroke-width="0.75" />
  <path d={ARROW} stroke-width="0.6" />

  {/* The column of the table this diamond keys into. Ruled on the head and the
      hours side only and left open at the foot and the fore edge, because it
      is an excerpt: a closed rectangle says the table ends here, which is the
      one thing it does not do. */}
  <path d="M98 5h-48v48" stroke-width="0.5" />
  <path d="M59 5v48" stroke-width="0.4" opacity="0.65" />
  <path d="M50 14h48" stroke-width="0.5" />
  <path d="M54.5 7.4 57.1 10 54.5 12.6 51.9 10Z" stroke-width="0.45" />
  <path d={CAPTIONS} stroke-width="0.45" opacity="0.8" />
  {ROWS.map((d, i) => (
    <path d={d} stroke-width={i === HW ? 0.65 : 0.55} opacity={i === HW ? 1 : 0.85} />
  ))}
</svg>
<span class="chart-mark__label">&lt;A&gt; 3.1kn 048&deg;</span>
