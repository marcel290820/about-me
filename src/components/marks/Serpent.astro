---
import { at, ridge, shell, spine, type Node, type Prof } from '@/lib/curves';

// --- Sea serpent ----------------------------------------------------------
// Cartographers drew these in the blank water. What it is wrapped around is a
// telegraph cable, and the labelled break is 1929: a slide off the Grand Banks
// snapped twelve of them in sequence, and the order they went in is how anyone
// worked out how fast a turbidity current travels.
//
// Wrapped round means over and under, so the body is one helix seen from the
// side. It crosses the cable three times -- in front, behind, in front -- which
// is one turn over the top and one under it. Everything here is drawn fat for
// the size it is printed at: at 118px a slim serpent and a thin cable make a
// squiggle on a rule, and the crossings, which are the whole point, disappear.
const CABLE = 34;
const FROM = 7;
const TO = 84;
const X0 = 20;

// The coil is a sine whose phase runs quadratically, so the pitch tightens
// toward the head: a long swell over the tail, a tighter bight under the neck.
// At a constant pitch the two humps came out the same period and the same
// curvature, and a matched pair reads as printed pattern rather than as an
// animal. Crossings land where the phase passes a multiple of pi, and the two
// constants are set so that all three are steep: a coil that meets the cable at
// a grazing angle leaves a gap the body's own edges then fill in, and the
// crossing is lost.
const C1 = 0.088;
const C2 = 0.000477;
const phase = (x: number) => C1 * (x - X0) + C2 * (x - X0) ** 2;

// Coil height grows from the tail. A helix has one amplitude, but an engraver
// would not have cared.
const AMP: Prof = [
  [0, 9],
  [0.42, 12],
  [0.62, 13.5],
  [0.8, 14.5],
  [1, 15.5],
];

// The last of the tail drops away from the cable and steepens into a flick.
// Left on the coil alone it ran a hair under the rule for a quarter of the mark
// and read as a second cable stub.
const FLICK = (t: number) => (t < 0.12 ? 3 * (1 - t / 0.12) ** 2 : 0);

const body = spine({
  from: FROM,
  to: TO,
  steps: 72,
  y: (t) =>
    CABLE - at(AMP, t) * Math.sin(phase(FROM + (TO - FROM) * t)) + FLICK(t),
  // Girth is widest at the bight and stays heavy through the neck. Thickness is
  // what makes a crossing legible: the cable is cut by the width of the body,
  // and where the body passes behind, that width is the channel the cable has
  // to show through.
  up: [
    [0, 0.5],
    [0.1, 3],
    [0.4, 4.8],
    [0.68, 6],
    [0.86, 5.6],
    [1, 4.4],
  ],
});

/** Unit tangent at each node, from its neighbours. */
const tan = body.map((_, i) => {
  const a = body[Math.max(i - 1, 0)];
  const b = body[Math.min(i + 1, body.length - 1)];
  const h = Math.hypot(b.x - a.x, b.y - a.y);
  return [(b.x - a.x) / h, (b.y - a.y) / h] as [number, number];
});

// shell() offsets the edges vertically, so a ribbon thins wherever the spine
// climbs -- which here is at every crossing, exactly where the width has to
// read. Scale the half-heights by the local secant and the body keeps one
// thickness the whole way round the coil.
for (let i = 0; i < body.length; i++) {
  const k = 1 / tan[i][0];
  body[i].u *= k;
  body[i].d *= k;
}

// Where the body actually crosses the cable, read off the sampled spine rather
// than solved by hand: retuning the chirp moves all three.
const crossings = body
  .filter((p, i) => i > 0 && (p.y - CABLE) * (body[i - 1].y - CABLE) < 0)
  .map((p) => p.x);
const UNDER = Math.round(crossings[1] * 10) / 10;

/** The lower edge, open. `ridge(n, () => 0)` is the upper one. */
const belly = (n: Node[]) =>
  'M' + n.map((p) => `${p.x.toFixed(1)} ${(p.y + p.d).toFixed(1)}`).join('L');

/**
 * Mane: spikes off the back, laid thirty-five degrees back off the local
 * normal. Straight spines are a comb, laid ones are a mane. Node index and
 * length are given one at a time rather than stepped and interpolated: even
 * spacing at even length is a repeat, and a repeat reads as printing.
 */
const mane = (spec: [number, number][]) =>
  spec
    .map(([i, l]) => {
      const p = body[i];
      const [tx, ty] = tan[i];
      const dx = ty * 0.82 - tx * 0.57;
      const dy = -tx * 0.82 - ty * 0.57;
      const y = p.y - p.u;
      return `M${p.x.toFixed(1)} ${y.toFixed(1)}L${(p.x + dx * l).toFixed(1)} ${(y + dy * l).toFixed(1)}`;
    })
    .join('');

// The head is laid out in its own frame -- x forward along the neck, y to the
// belly side -- so the whole skull stays on the neck when the coil changes.
// Heading off the tangent at the tip, not a longer chord: the neck is bending
// hard here, so a three-step chord came out sixteen degrees steeper than the
// line the crown actually has to leave on, and the jaw then hung forward like a
// blade instead of dropping open.
const tip = body[body.length - 1];
const rad = Math.atan2(tan[tan.length - 1][1], tan[tan.length - 1][0]);
const cos = Math.cos(rad);
const sin = Math.sin(rad);
const hp = (x: number, y: number): [number, number] => [
  tip.x + x * cos - y * sin,
  tip.y + x * sin + y * cos,
];
const H = (x: number, y: number) => {
  const [a, b] = hp(x, y);
  return `${a.toFixed(1)} ${b.toFixed(1)}`;
};
const [eyeX, eyeY] = hp(10.3, -4.8);

// The mane runs on past the crossing and up the nape, but the neck stands near
// vertical there and its own normal lays a spike out level, which read as
// whiskers off the jaw. These two take their heading off the skull instead, up
// and back at the head's own angle.
const NAPE: [number, number] = [-0.29 * cos + 0.96 * sin, -0.29 * sin - 0.96 * cos];
const nape = ([[71, 7.2], [68, 5.2]] as [number, number][])
  .map(([i, l]) => {
    const p = body[i];
    const y = p.y - p.u;
    return `M${p.x.toFixed(1)} ${y.toFixed(1)}L${(p.x + NAPE[0] * l).toFixed(1)} ${(y + NAPE[1] * l).toFixed(1)}`;
  })
  .join('');

// The head is the front end of the same animal, not a shape parked in front of
// it, so the crown and the throat start on the body's own edges and there is
// nothing to knock out. The neck's outline ends on a vertical cap, which those
// two points are not symmetric about -- take them off the body rather than
// guessing, or the head sits a stroke clear of the neck.
const crownFrom = `${tip.x.toFixed(1)} ${(tip.y - tip.u).toFixed(1)}`;
const throatFrom = `${tip.x.toFixed(1)} ${(tip.y + tip.d).toFixed(1)}`;
---

<svg viewBox="0 0 120 58" fill="none" stroke="currentColor" stroke-width="0.9">
  {/* The cable is printed datum, the serpent is decoration, so the cable runs
      lighter and thinner. At one weight the two read as a single drawing and
      the crossings have no contrast to work with. */}
  <path d={`M0 ${CABLE}h120`} stroke-width="0.5" opacity="0.7" />
  {/* The break, ticked on the clear cable directly under the open jaws. */}
  <path d={`M91 ${CABLE - 4}v8M96 ${CABLE - 4}v8`} stroke-width="0.5" opacity="0.7" />

  {/* Paper under the body knocks the cable out at the two crossings the
      serpent passes in front of, ten to twelve units of it at each. */}
  <path d={shell(body)} fill="var(--color-paper)" stroke="none" />
  {/* Two open edges rather than shell(): a closed outline walls off the neck
      exactly where the head has to grow out of it. */}
  <path d={ridge(body, () => 0)} />
  <path d={belly(body)} />
  <path
    d={mane([
      [17, 3.4],
      [23, 6.6],
      [28, 5],
      [33, 3],
    ])}
    stroke-width="0.6"
  />
  <path d={nape} stroke-width="0.6" />

  {/* The middle crossing goes behind. The cable is redrawn over the body on a
      paper halo, so the body's outline is what breaks and the cable is not.
      What sells the wrap is the run of cable showing in the channel between the
      body's two edges, so the bight is the fattest part of the animal. The halo
      is only just wider than the cable, on purpose: at four units the outlines
      stopped well short of the line and the body read as broken rather than
      passed behind, and at six it read as a hole punched in the animal. The
      edges have to run up to the cable and stop there. */}
  <path d={`M${UNDER - 10} ${CABLE}h20`} stroke="var(--color-paper)" stroke-width="2" />
  <path d={`M${UNDER - 10} ${CABLE}h20`} stroke-width="0.5" opacity="0.7" />

  {/* Skull: nape, a brow over the eye, then a dished run forward to a muzzle
      that drops off a wall, and the biting edge back to the hinge. The brow is
      what breaks the roof: run as one convex arc from nape to snout it came out
      a duck every time, whatever the jaw was doing. The first control point
      runs on along the neck, or the crown leaves the body at a corner. */}
  <path
    d={`M${crownFrom}C${H(5.5, -4.8)} ${H(7.2, -8.4)} ${H(9.8, -8.6)}C${H(12.2, -8.8)} ${H(13.7, -7.4)} ${H(15.6, -6.7)}C${H(18.2, -6)} ${H(20.2, -5)} ${H(20.4, -3.4)}C${H(20.5, -2.3)} ${H(19.9, -1.6)} ${H(19.1, -1.3)}C${H(14.9, -0.6)} ${H(10.3, 0)} ${H(6.2, 0.5)}`}
  />
  {/* Lower jaw: a mandible five deep at the ramus, not the blade the first
      draft drew, swung forty-seven degrees off the skull and blunt at the tip.
      The head is rotated onto the neck, which swings a deep point rightwards,
      so the jaw stops short in its own frame; run it out as far as the muzzle
      and it overshoots into an underbite. Open at the throat so it overlaps the
      neck, because the join would have to be hidden, and the first control
      point runs on along the belly or the throat leaves at an elbow. */}
  <path
    d={`M${throatFrom}C${H(0.7, 4.1)} ${H(3.6, 7.8)} ${H(7.6, 9.4)}C${H(10.2, 10.4)} ${H(12.6, 10.2)} ${H(14, 9)}C${H(11.8, 6.7)} ${H(9, 3.8)} ${H(6.2, 0.5)}`}
  />
  {/* One horn off the back of the skull, drawn as a spike: two lines meeting at
      the point, open at the base where it leaves the head. A matched pair read
      as a fitting, a thin arc read as a feather, and a long upright one read as
      a party hat, so it is short and laid back into the line of the mane. */}
  <path d={`M${H(6.7, -7.7)}Q${H(4.2, -10.6)} ${H(3, -13.2)}Q${H(6.6, -11)} ${H(9.8, -8.6)}`} stroke-width="0.7" />
  {/* Forked tongue on the axis of the gape. One stroke, and it is the stroke
      that says serpent rather than lizard. The fangs that used to sit in the
      gape with it went to mud at true size and are gone. */}
  <path
    d={`M${H(7.9, 2.6)}C${H(12, 3.9)} ${H(15.8, 4.8)} ${H(18.5, 5)}M${H(18.5, 5)}L${H(21.2, 3.9)}M${H(18.5, 5)}L${H(20.8, 7)}`}
    stroke-width="0.5"
  />
  <circle cx={eyeX.toFixed(1)} cy={eyeY.toFixed(1)} r="1.05" fill="currentColor" stroke="none" />
</svg>
<span class="chart-mark__label">subm cable, rep 1929</span>
