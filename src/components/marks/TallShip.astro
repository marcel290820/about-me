---
import Ship from '@/components/marks/Ship.astro';
---

<svg viewBox="0 0 116 76" fill="none" stroke="currentColor" stroke-width="0.7">
  {/* The track she made, hourly fixes ticked along it, running off the
      edge of the paper at both ends: the passage is longer than the chart. */}
  <path d="M-2 62C18 58 30 66 46 60" stroke-width="0.5" stroke-dasharray="2 3" opacity="0.7" />
  <path d="M12 58v6M30 59v6" stroke-width="0.5" opacity="0.7" />
  <Ship transform="translate(72 66) scale(0.72)" />
  <path d="M6 72h104" stroke-width="0.5" opacity="0.35" />
</svg>
<span class="chart-mark__label">under sail 2018-19</span>
