---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import TagList from '@/components/TagList.astro';
import Neighbours from '@/components/Neighbours.astro';
import { logDate } from '@/lib/log';

interface Props {
  post: CollectionEntry<'blog'>;
  earlier: CollectionEntry<'blog'> | null;
  later: CollectionEntry<'blog'> | null;
  minutes: number;
}

const { post, earlier, later, minutes } = Astro.props;
const { title, description, pubDate, updatedDate, place, tags, draft } = post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: updatedDate?.toISOString() ?? pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Marcel Heidebrecht',
    url: 'https://marcel-heidebrecht.de',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};

const linkClass =
  'inline-block font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-text-dim hover:text-accent transition-colors';
---

<Base title={title} description={description} surface>
  {/* The whole entry is read on paper. The rail runs down its margin the way
      it does on the CV, with the fix pinned at the top. */}
  <article slot="surface" class="rail pt-8 pb-16 sm:pt-12 sm:pb-24">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <header class="mb-10">
      <p class="rail__fix font-mono text-xs text-text-dim mb-4">
        <time datetime={pubDate.toISOString()}>{logDate(pubDate)}</time>{place && `, ${place}`}
        <span class="log-entry__min">{minutes} min</span>
        {updatedDate && <span class="log-entry__min">updated {logDate(updatedDate)}</span>}
        {import.meta.env.DEV && draft && <span class="log-entry__min text-accent">draft</span>}
      </p>
      <h1 class="display-name display-name--entry mb-5">{title}</h1>
      <p class="text-lg leading-relaxed text-text-muted mb-6 max-w-[62ch]">{description}</p>
      {tags.length > 0 && <TagList tags={tags} />}
    </header>
    <div class="prose" data-pagefind-body>
      <slot />
    </div>
    {import.meta.env.DEV && (
      <p class="mt-12">
        <a href={`/write?entry=${post.id}`} class={linkClass}>edit this entry at the chart table &rarr;</a>
      </p>
    )}
  </article>

  <nav aria-label="Neighbouring entries">
    <div class="section-heading">
      <h2>earlier and later</h2>
    </div>
    <Neighbours earlier={earlier} later={later} />
    <a href="/blog" class:list={[linkClass, 'mt-8']}>&larr; back to the remarks</a>
  </nav>

  <script>
    document.querySelectorAll('pre').forEach((pre) => {
      const button = document.createElement('button');
      button.className = 'copy-button';
      button.textContent = 'copy';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (code) {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.textContent = 'copied!';
          setTimeout(() => {
            button.textContent = 'copy';
          }, 2000);
        }
      });
      pre.style.position = 'relative';
      pre.appendChild(button);
    });
  </script>
</Base>
