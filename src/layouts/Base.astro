---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '@/assets/images/marcel-heidebrecht-portrait.jpeg';

interface Props {
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const description =
  'Software engineer in Berlin. Software development, cloud and DevOps alongside studies at TU Berlin and volunteer work at CCT.';
const socialImageSize = 640;
const socialImage = await getImage({
  src: portrait,
  width: socialImageSize,
  height: socialImageSize,
  fit: 'cover',
  format: 'jpg',
});
const canonicalURL = new URL('/', Astro.site);
const socialImageURL = new URL(socialImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f7f6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(socialImageSize)} />
    <meta property="og:image:height" content={String(socialImageSize)} />
    <meta property="og:image:alt" content="Portrait" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
  </head>
  <body>
    <slot />
  </body>
</html>
