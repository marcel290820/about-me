---
import Page from '@/layouts/Page.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/images/marcel-heidebrecht-portrait.jpeg';
import Passage from '@/components/Passage.astro';

// Read as a soundings table: field on the left, what was found on the right.
const skills: [string, string][] = [
  ['full-stack', 'JVM ecosystem, TypeScript, Python, Vue, Astro, Spring, FastAPI, Rust, Solana'],
  ['devops', 'CI/CD systems, Terraform, Ansible, OpenTelemetry, Grafana LGTM, Git'],
  ['cloud', 'AWS, GCP, Azure, Kubernetes, Docker, Fabric, Databricks'],
  ['certs', 'ITILv4 Foundation, Azure Fundamentals AZ-900, Fabric Data Engineer DP-700'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marcel Heidebrecht',
  url: 'https://marcel-heidebrecht.de',
  email: 'marcel@heidebrecht.de',
  jobTitle: 'Fullstack Engineer & DevOps Enthusiast',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Berlin',
    addressCountry: 'DE',
  },
  sameAs: [
    'https://github.com/marcel290820',
    'https://www.linkedin.com/in/marcel-heidebrecht-a52296212',
    'https://x.com/marcel290820',
  ],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Technische Universitat Berlin' },
  ],
  knowsAbout: [
    'Full-Stack Development',
    'DevOps',
    'Cloud Infrastructure',
    'Kubernetes',
    'Terraform',
    'TypeScript',
    'Python',
    'JVM Ecosystem',
  ],
};
---

<Page title="About" description="About Marcel Heidebrecht - Fullstack Engineer and DevOps Enthusiast based in Berlin" surface>
  <div slot="surface" class="pt-8 pb-16 sm:pt-12 sm:pb-24">
    <h1 class="display-name mb-10">About me</h1>

    <div class="flex flex-col-reverse sm:flex-row items-start gap-8 sm:gap-10">
      <div class="flex-1 prose max-w-none">
        <p>I'm a fullstack engineer and DevOps enthusiast based in Berlin. Right now I'm finishing my M.Sc. in Industrial Engineering & IT at TU Berlin. I just wrapped up six months as a DevOps Engineer at Capgemini, where I built the observability stack for a sovereign AI platform. Most of what I do sits between software and infrastructure: AWS EKS migrations with Terraform, Python automation, full-stack tooling. Before any of that I spent six months on a sailing ship, mentoring students and helping with microplastic research. That trip is still why I prefer working on whole systems instead of single features.</p>
      </div>
      <figure class="portrait-inset shrink-0">
        <div class="portrait-inset__frame">
          <Image
            src={portrait}
            alt="Marcel Heidebrecht"
            width={640}
            height={640}
            class="object-cover w-32 h-40 sm:w-44 sm:h-56"
          />
        </div>
        <figcaption>Berlin, 52&deg;31'N 013&deg;24'E</figcaption>
      </figure>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mb-24 sm:mb-32">
    <div class="section-heading">
      <h2>experience</h2>
    </div>
    <div class="flex flex-col gap-9">
      <div class="rail">
        <h3 class="text-base font-semibold mb-1">DevOps Engineer (Werkstudent)</h3>
        <p class="font-mono text-sm text-accent mb-1">Capgemini Deutschland GmbH</p>
        <p class="font-mono text-xs text-text-dim mb-3">Feb 2026 to Jul 2026, Berlin</p>
        <ul class="text-[0.9375rem] text-text-muted list-disc pl-4 space-y-1.5">
          <li>Central observability stack for a sovereign AI platform: OpenTelemetry pipelines into Grafana LGTM, across ~40 tenants and 70+ services</li>
          <li>Every component deployed and configured through Ansible; Docker Swarm rollout and operations</li>
          <li>Instrumented the platform end to end, from Traefik and Authentik to LiteLLM and OpenWebUI</li>
        </ul>
      </div>

      <div class="rail">
        <h3 class="text-base font-semibold mb-1">Cloud, Data &amp; AI Consultant (Werkstudent)</h3>
        <p class="font-mono text-sm text-accent mb-1">Campana &amp; Schott GmbH</p>
        <p class="font-mono text-xs text-text-dim mb-3">Apr 2025 to Jan 2026, Berlin</p>
        <ul class="text-[0.9375rem] text-text-muted list-disc pl-4 space-y-1.5">
          <li>AI-powered lead generation agent in Python with browser automation</li>
          <li>Migration concept consolidating Azure Data Factory and Databricks into Microsoft Fabric</li>
        </ul>
      </div>

      <div class="rail">
        <h3 class="text-base font-semibold mb-1">Software Engineer (Werkstudent)</h3>
        <p class="font-mono text-sm text-accent mb-1">Sourcepark GmbH</p>
        <p class="font-mono text-xs text-text-dim mb-3">Nov 2021 to Apr 2025, Berlin</p>
        <ul class="text-[0.9375rem] text-text-muted list-disc pl-4 space-y-1.5">
          <li>Migrated a microservice system to AWS EKS: Terraform provisioning, Ansible configuration</li>
          <li>Java OCR app on Tesseract, a Playwright test suite, a full-stack security scanner</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-24 sm:mb-32">
    <div class="section-heading">
      <h2>education</h2>
    </div>
    <div class="flex flex-col gap-9">
      <div class="rail">
        <h3 class="text-base font-semibold mb-1">M.Sc. Wirtschaftsingenieurwesen (IT)</h3>
        <p class="font-mono text-sm text-accent mb-1">Technische Universitat Berlin</p>
        <p class="font-mono text-xs text-text-dim mb-3">Oct 2023 to present</p>
        <p class="text-[0.9375rem] text-text-muted">GPA 1.3. Focus on DevOps, cloud platforms and distributed systems</p>
      </div>
      <div class="rail">
        <h3 class="text-base font-semibold mb-1">B.Sc. Wirtschaftsingenieurwesen (IT)</h3>
        <p class="font-mono text-sm text-accent mb-1">Technische Universitat Berlin</p>
        <p class="font-mono text-xs text-text-dim mb-3">Oct 2019 to Sep 2023</p>
        <p class="text-[0.9375rem] text-text-muted">GPA 1.3, top 3%. Focus on software engineering, web technologies and project management</p>
      </div>
    </div>
  </section>

  <section class="mb-24 sm:mb-32">
    <div class="section-heading">
      <h2>extracurricular</h2>
    </div>
    <div class="rail">
      <h3 class="text-base font-semibold mb-1">Student Consultant</h3>
      <p class="font-mono text-sm text-accent mb-1">Company Consulting Team e.V.</p>
      <p class="font-mono text-xs text-text-dim mb-3">Jun 2024 to present, Berlin</p>
      <ul class="text-[0.9375rem] text-text-muted list-disc pl-4 space-y-1.5">
        <li>Led the database redesign: 10x faster</li>
        <li>Internal LLM infrastructure, a Slack app in Python, GitLab CI/CD pipelines</li>
      </ul>
    </div>
  </section>

  <section class="mb-24 sm:mb-32">
    <div class="section-heading">
      <h2>skills</h2>
    </div>
    <dl class="border-t border-border-subtle">
      {skills.map(([field, list]) => (
        <div class="grid grid-cols-[6.5rem_1fr] sm:grid-cols-[9rem_1fr] gap-4 py-3.5 border-b border-border-subtle">
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-accent pt-0.5">{field}</dt>
          <dd class="text-[0.9375rem] text-text-muted">{list}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section>
    <div class="section-heading">
      <h2>beyond code</h2>
    </div>
    <div class="rail">
      <h3 class="text-base font-semibold mb-1">Atlantic circuit under sail</h3>
      <p class="font-mono text-sm text-accent mb-1">Ocean College</p>
      <p class="font-mono text-xs text-text-dim mb-3">Oct 2018 to Apr 2019, both sides of the Atlantic</p>
      <p class="text-[0.9375rem] text-text-muted">Six months aboard a tall ship, Ireland to France the long way round: England, Spain and Morocco, out to Tenerife and Cape Verde, across the trades to the Caribbean, on to Costa Rica, Panama, Cuba and the Bahamas, and home by the Azores. I mentored 26 students on board and helped run the microplastics research that was later published in the FAZ.</p>
    </div>

    {/* Outside the rail so its hairline does not run through the plot. */}
    <Passage detail class="mt-10" />
  </section>

</Page>
