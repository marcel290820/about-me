---
import Base from '@/layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/images/marcel-heidebrecht-portrait.jpeg';
---

<Base title="Software engineer in Berlin">
  <main>
    <section class="intro column" aria-labelledby="intro-title">
      <div class="intro-header">
        <figure class="portrait">
          <Image
            src={portrait}
            alt="Portrait"
            width={120}
            height={135}
            densities={[1, 2, 3]}
            quality={90}
            fit="cover"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <p class="role">Software engineer<br />Berlin</p>
      </div>

      <h1 id="intro-title">I build software<br />and keep it running.</h1>
      <p class="intro-copy">
        I'm finishing a master's in Industrial Engineering and Management at
        TU Berlin, with a focus on IT. Alongside university, I've worked as a
        student in software engineering at <a href="https://sourcepark.de/">Sourcepark</a>,
        cloud consulting at <a href="https://www.campana-schott.com/de/de/">Campana &amp; Schott</a>,
        and DevOps at <a href="https://www.capgemini.com/">Capgemini</a>.
      </p>
    </section>

    <div class="work column">
      <p>
        I also volunteer at <a href="https://cct-ev.de/">CCT e.V.</a>, a student consultancy. I've contributed to its
        member portal and Slack support bot, and built the <a href="https://www.juniter.de/">JunITer website</a> with
        other members. That work includes getting changes into production and
        maintaining them afterwards. I work in the terminal: Ghostty, zsh and
        tmux, with pi as my coding agent.
      </p>
    </div>

    <div class="sea">
      <section class="outside column" aria-labelledby="outside-title">
        <h2 id="outside-title">Away from keyboard</h2>
        <p>
          I spent six months sailing with <a href="https://oceancollege.eu/en/">Ocean College</a>.
          I'm also a certified diver (AOWD). There's gravel riding, too,
          whenever I can get out.
        </p>
      </section>
      <footer class="column">
        <nav aria-label="Contact and profiles">
          <a href="mailto:marcel@heidebrecht.de">Email</a>
          <a href="https://github.com/marcel290820">GitHub</a>
          <a href="https://www.linkedin.com/in/marcel-heidebrecht-a52296212">LinkedIn</a>
        </nav>
      </footer>
    </div>
  </main>
</Base>
