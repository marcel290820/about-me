---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Passage from '@/components/Passage.astro';
import PostCard from '@/components/PostCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.sortOrder - a.data.sortOrder)
  .slice(0, 3);

const interests = (await getCollection('interests')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base title="Home" surface>
  <Hero slot="surface" />

  {allPosts.length > 0 && (
    <section class="mb-24 sm:mb-32">
      <div class="section-heading">
        <h2>recent posts</h2>
      </div>
      <div class="flex flex-col gap-3">
        {allPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id}
          />
        ))}
      </div>
      <a href="/blog" class="inline-block mt-6 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-text-dim hover:text-accent transition-colors">
        all posts &rarr;
      </a>
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section>
      <div class="section-heading">
        <h2>featured projects</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            url={project.data.url}
            repo={project.data.repo}
          />
        ))}
      </div>
      <a href="/projects" class="inline-block mt-6 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-text-dim hover:text-accent transition-colors">
        all projects &rarr;
      </a>
    </section>
  )}

  {/* The landing page has to descend too. The first screen under the line is
      left as water, with the buoy riding in it; this sits below that. Taller
      than one viewport on purpose: the water column only wakes once the
      waterline has left the top of the frame, and a deep zone shorter than
      the screen never gets there. */}
  <section class="min-h-[108vh] pt-[25rem] sm:pt-[31rem] xl:pt-[16rem] flex flex-col justify-end">
    {/* What you find down here: the owner's own track, before the list. The
        top padding clears the buoy's mooring where the two can share a
        column (the buoy rides at 74 to 86 percent, the column ends at 75 at
        1208px), and drops once the frame is clear of it so the plot's top
        edge sits inside the first screen of water. */}
    <Passage detail class="mb-20 sm:mb-28" />
    <div class="section-heading">
      <h2>beyond code</h2>
    </div>
    <dl class="border-t border-border-subtle">
      {interests.map((i) => (
        <div class="grid grid-cols-[6.5rem_1fr] sm:grid-cols-[9rem_1fr] gap-4 py-3.5 border-b border-border-subtle">
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-accent pt-0.5">{i.data.title}</dt>
          <dd class="text-[0.9375rem] text-text-muted">{i.data.description}</dd>
        </div>
      ))}
    </dl>
    {/* Set like the section heads above it, so the one action down here
        speaks the same language as the controls. */}
    <a href="/about" class="inline-flex items-center gap-3 mt-8 font-sans font-semibold uppercase tracking-[0.1em] text-[0.9375rem] [font-stretch:68%] text-text hover:text-accent transition-colors">
      the full log
      <span class="w-1 h-1 rounded-full bg-accent" aria-hidden="true"></span>
    </a>
  </section>
</Base>
