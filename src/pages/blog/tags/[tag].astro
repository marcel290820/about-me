---
import Page from '@/layouts/Page.astro';
import Log from '@/components/Log.astro';
import Wayfinding from '@/components/Wayfinding.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { newestFirst } from '@/lib/log';

export async function getStaticPaths() {
  const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(newestFirst);
  const tags = [...new Set(all.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: { tag, all, posts: all.filter((post) => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  all: CollectionEntry<'blog'>[];
  posts: CollectionEntry<'blog'>[];
}

const { tag, all, posts } = Astro.props;
---

<Page title={`Remarks tagged "${tag}"`} description={`Blog posts about ${tag} by Marcel Heidebrecht`} surface>
  <div slot="surface" class="pt-8 pb-16 sm:pt-12 sm:pb-24">
    <a href="/blog" class="inline-block mb-8 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-text-muted hover:text-text transition-colors">
      &larr; all remarks
    </a>
    <h1 class="display-name mb-12">
      <span class="text-accent">#</span>{tag}
    </h1>
    <Log posts={posts} />
  </div>

  <Wayfinding posts={all} activeTag={tag} />
</Page>
